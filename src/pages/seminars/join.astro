---
import OrgLayout from "../../layouts/OrgLayout.astro";
import PublicSeminarForm from "../../components/PublicSeminarForm.astro";
import "../../styles/seminars-public.css";
---

<OrgLayout
  title="ゼミ参加フォーム"
  description="参加を希望するゼミへ申請できます。主催者の承認後に参加できます。"
  noindex
>
  <div class="container public-seminar" data-public-seminar-form="join">
    <p class="public-seminar-back"><a href="/seminars/">ゼミ一覧に戻る</a></p>
    <header class="public-seminar-detail-heading">
      <h1>ゼミ参加フォーム</h1>
      <p>申請後、主催者が内容を確認します。参加者情報と連絡先は主催者に伝わります。</p>
    </header>
    <PublicSeminarForm kind="join" />
  </div>
  <script>
    import "../../scripts/public-seminars";
  </script>
</OrgLayout>
