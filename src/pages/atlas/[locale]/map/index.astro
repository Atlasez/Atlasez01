---
/**
 * 学習地図ページ。中身は総合ホームの「学習地図」タブと共通のコンポーネント。
 */
import AtlasLayout from "../../../../layouts/AtlasLayout.astro";
import Breadcrumb from "../../../../components/Breadcrumb.astro";
import LearningMap from "../../../../components/LearningMap.astro";
import { atlasPath } from "../../../../lib/site";
import { t, LOCALES, type Locale } from "../../../../lib/i18n";

export function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
---

<AtlasLayout
  locale={locale}
  title={t(locale, "map")}
  description={locale === "ja"
    ? "概念の前提関係をたどれる学習地図。開始地点と目的地点を選ぶと学習ルートを表示します。"
    : "A learning map of concepts and their prerequisites, with route search."}
  localeSwitchHrefs={Object.fromEntries(
    LOCALES.map((l) => [l, atlasPath(l, "map")]),
  )}
>
  <div class="container" data-map-page data-map-page-locale={locale}>
    <div data-map-page-breadcrumb>
      <Breadcrumb
        items={[
          { label: t(locale, "breadcrumbHome"), href: atlasPath(locale) },
          { label: t(locale, "map") },
        ]}
      />
    </div>
    <h1 data-map-page-heading>{t(locale, "map")}</h1>
    <p class="reading">
      {
        locale === "ja"
          ? "学びたい分野と目標を選ぶと、前提から順に読む記事を表示します。概念どうしの関係を詳しく見たい場合は、その下の概念マップを開いてください。"
          : "Choose a subject and a goal to see articles in prerequisite order. Open the concept map below only when you want to explore the relationships in detail."
      }
    </p>
    <LearningMap locale={locale} />
  </div>
</AtlasLayout>

<script>
  const mapPage = document.querySelector<HTMLElement>("[data-map-page]");
  const mapPageHeading = mapPage?.querySelector<HTMLElement>(
    "[data-map-page-heading]",
  );
  const mapPageBreadcrumb = mapPage?.querySelector<HTMLElement>(
    "[data-map-page-breadcrumb] .breadcrumb",
  );
  const mapPageBreadcrumbList = mapPageBreadcrumb?.querySelector<HTMLOListElement>(
    "ol",
  );
  const mapPageHeadingTemplate = mapPageHeading?.textContent ?? "";
  const mapPageBreadcrumbTemplate = mapPageBreadcrumbList?.innerHTML ?? "";
  const mapPageLocale = mapPage?.dataset.mapPageLocale ?? "ja";
  const mapPageHome = mapPageBreadcrumbList?.firstElementChild;
  const mapPageHomeLabel = mapPageHome?.textContent?.trim() ?? "Atlas";
  const mapPageHomeHref =
    mapPageHome?.querySelector<HTMLAnchorElement>("a")?.href ?? "/";

  type MapCategoryChange = {
    subject?: string;
    categoryKey?: string | null;
    subjectName?: string;
    categoryName?: string;
  };

  function atlasSubjectPath(subject: string): string {
    const prefix = location.pathname.split("/atlas/")[0] || "";
    return `${prefix}/atlas/${mapPageLocale}/${encodeURIComponent(subject)}/`;
  }

  function createBreadcrumb(label: string, href?: string): HTMLLIElement {
    const item = document.createElement("li");
    if (href) {
      const link = document.createElement("a");
      link.href = href;
      link.textContent = label;
      item.append(link);
    } else {
      const current = document.createElement("span");
      current.setAttribute("aria-current", "page");
      current.textContent = label;
      item.append(current);
    }
    return item;
  }

  function restoreMapPageContext(): void {
    if (mapPageHeading) mapPageHeading.textContent = mapPageHeadingTemplate;
    if (mapPageBreadcrumbList) {
      mapPageBreadcrumbList.innerHTML = mapPageBreadcrumbTemplate;
    }
  }

  function syncMapPageContext(detail: MapCategoryChange): void {
    const categoryKey = detail.categoryKey ?? "";
    if (!categoryKey) {
      restoreMapPageContext();
      return;
    }
    const [subject, categorySlug] = categoryKey.split("/");
    const subjectName = detail.subjectName || subject;
    const categoryName = detail.categoryName || categorySlug;
    if (mapPageHeading) mapPageHeading.textContent = categoryName;
    if (mapPageBreadcrumbList) {
      mapPageBreadcrumbList.replaceChildren(
        createBreadcrumb(mapPageHomeLabel, mapPageHomeHref),
        createBreadcrumb(subjectName, atlasSubjectPath(subject)),
        createBreadcrumb(categoryName),
      );
    }
  }

  window.addEventListener("atlas-map-category-change", (event) => {
    syncMapPageContext(
      (event as CustomEvent<MapCategoryChange>).detail ?? {},
    );
  });

  // 地図の初期化とページスクリプトの実行順が変わっても、直リンクの
  // category パラメータから同じ見出し・パンくずを復元する。
  const initialCategory = new URL(location.href).searchParams.get("category");
  if (initialCategory) {
    const canvas = document.querySelector<HTMLElement>("#learning-map");
    const categories = JSON.parse(canvas?.dataset.categories ?? "[]") as Array<{
      subject: string;
      slug: string;
      name: string;
    }>;
    const subjects = JSON.parse(canvas?.dataset.subjects ?? "[]") as Array<{
      slug: string;
      name: string;
    }>;
    const [subject, categorySlug] = initialCategory.split("/");
    const category = categories.find(
      (item) => `${item.subject}/${item.slug}` === initialCategory,
    );
    const subjectMeta = subjects.find((item) => item.slug === subject);
    syncMapPageContext({
      subject,
      categoryKey: initialCategory,
      subjectName: subjectMeta?.name ?? subject,
      categoryName: category?.name ?? categorySlug,
    });
  }
</script>
