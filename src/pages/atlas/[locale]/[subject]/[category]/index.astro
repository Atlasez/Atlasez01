---
/** カテゴリの記事一覧。グリッド／リスト切替付き */
import AtlasLayout from "../../../../../layouts/AtlasLayout.astro";
import Breadcrumb from "../../../../../components/Breadcrumb.astro";
import LearningMap from "../../../../../components/LearningMap.astro";
import {
  atlasPath,
  articlePath,
  formatDate,
} from "../../../../../lib/site";
import {
  t,
  LOCALES,
  localizedName,
  type Locale,
} from "../../../../../lib/i18n";
import {
  getPublishedArticles,
  getPublishedSubjects,
  getConcepts,
  articlePrerequisiteConceptIds,
} from "../../../../../lib/content";
import {
  getPlannedArticles,
  plannedProgress,
  plannedArticleTitle,
} from "../../../../../lib/planned";

export async function getStaticPaths() {
  const subjects = (await getPublishedSubjects()).filter(
    (s) => s.data.status === "published",
  );
  return LOCALES.flatMap((locale) =>
    subjects.flatMap((s) =>
      s.data.categories.map((cat) => ({
        params: { locale, subject: s.data.slug, category: cat.slug },
        props: { subject: s, category: cat },
      })),
    ),
  );
}

const locale = Astro.params.locale as Locale;
const { subject, category } = Astro.props;
const { map } = await getConcepts();
const articles = (await getPublishedArticles(locale)).filter(
  (a) =>
    a.data.subject === subject.data.slug &&
    a.data.category === category.slug,
);
const subjectName = localizedName(subject.data.name, locale);
const categoryName = localizedName(category.name, locale);
const planned = getPlannedArticles(subject.data.slug, category.slug);
const recentArticles = [...articles]
  .sort((a, b) => b.data.updatedAt.getTime() - a.data.updatedAt.getTime())
  .slice(0, 6);
const views = [
  { id: "tiles", label: t(locale, "tileView") },
  { id: "list", label: t(locale, "listViewTab") },
  { id: "map", label: t(locale, "map") },
] as const;
const summary =
  locale === "ja"
    ? `${articles.length}記事を公開中${planned.length > 0 ? `・準備中${planned.length}件` : ""}`
    : `${articles.length} articles${planned.length > 0 ? ` · ${planned.length} planned` : ""}`;

/** 各記事の表示用データ（前提概念名も解決しておく） */
const items = articles.map((a) => ({
  article: a,
  prereqNames: articlePrerequisiteConceptIds(a, map)
    .map((id) => {
      const c = map.get(id);
      return c ? localizedName(c.name, locale) : id;
    })
    .slice(0, 4),
  href: articlePath(locale, a.data.subject, a.data.category, a.data.slug),
}));
---

<AtlasLayout
  locale={locale}
  title={`${categoryName} - ${subjectName}`}
  description={locale === "ja"
    ? `${categoryName}の記事一覧`
    : `Articles in ${categoryName}`}
  noindex={articles.length === 0 && planned.length === 0}
  localeSwitchHrefs={Object.fromEntries(
    LOCALES.map((l) => [l, atlasPath(l, subject.data.slug, category.slug)]),
  )}
>
  <div
    class="container category-home"
    data-category-layout
    data-active-view="tiles"
    data-view-storage-key={`atlasez-category-view:${subject.data.slug}/${category.slug}`}
  >
    <div class="content-columns">
      <section class="category-main">
        <div data-category-breadcrumb>
          <Breadcrumb
            items={[
              { label: t(locale, "breadcrumbHome"), href: atlasPath(locale) },
              { label: subjectName, href: atlasPath(locale, subject.data.slug) },
              { label: categoryName },
            ]}
          />
        </div>
        <h1>{categoryName}</h1>

    <div class="view-bar">
      <div
        class="view-tabs"
        role="tablist"
        aria-label={t(locale, "viewSwitcher")}
        data-view-tabs
      >
        {
          views.map((view, index) => (
            <button
              type="button"
              role="tab"
              id={`category-view-tab-${view.id}`}
              class="view-tab"
              data-view-tab={view.id}
              aria-selected={index === 0 ? "true" : "false"}
              aria-controls={view.id === "map"
                ? "category-view-panel-map"
                : "category-view-panel-articles"}
              tabindex={index === 0 ? undefined : "-1"}
            >
              {view.label}
            </button>
          ))
        }
      </div>
      <p class="section-meta">{summary}</p>
    </div>
    <p class="visually-hidden" aria-live="polite" data-context-search-status></p>

    <div
      id="category-view-panel-articles"
      class="view-panel"
      role="tabpanel"
      aria-labelledby="category-view-tab-tiles"
      data-article-view-panel
    >
    <ul class="article-collection" data-view="grid">
      {
        items.map(({ article: a, prereqNames, href }) => (
          <li
            class="article-item card"
            data-title={`${a.data.title} ${a.data.summary} ${a.data.tags.join(" ")} ${a.data.aliases.join(" ")}`}
            data-context-search-item
            data-search-text={`${a.data.title} ${a.data.summary} ${a.data.tags.join(" ")} ${a.data.aliases.join(" ")}`}
          >
            <h2 class="article-title">
              <a href={href}>{a.data.title}</a>
            </h2>
            <p class="article-summary">{a.data.summary}</p>
            <p class="article-badges">
              <span class="badge">
                {t(locale, "updatedAt")}:
                <time datetime={a.data.updatedAt.toISOString().slice(0, 10)}>
                  {formatDate(a.data.updatedAt, locale)}
                </time>
              </span>
              <span class="badge" title={t(locale, "exercisePreparing")}>
                {t(locale, "preExercise")}（{t(locale, "preparing")}）
              </span>
              <span class="badge" title={t(locale, "exercisePreparing")}>
                {t(locale, "postExercise")}（{t(locale, "preparing")}）
              </span>
            </p>
            {prereqNames.length > 0 && (
              <p class="article-prereqs">
                <span class="prereq-label">{t(locale, "prerequisites")}:</span>
                {prereqNames.join("、")}
              </p>
            )}
          </li>
        ))
      }
      {
        planned.map((item, index) => (
          <li
            class="article-item card planned-article"
            id={index === 0 ? "planned-articles" : undefined}
            data-title={plannedArticleTitle(item, locale)}
            data-context-search-item
            data-search-text={plannedArticleTitle(item, locale)}
          >
            <p class="article-status">
              {t(locale, "preparing")}
              <span
                class:list={[
                  "badge",
                  {
                    "badge-accent": plannedProgress(item) === "in-progress",
                  },
                ]}
              >
                {plannedProgress(item) === "in-progress"
                  ? t(locale, "progressInProgress")
                  : t(locale, "progressNotStarted")}
              </span>
            </p>
            <h2 class="article-title">{plannedArticleTitle(item, locale)}</h2>
          </li>
        ))
      }
    </ul>
    </div>

    <div
      id="category-view-panel-map"
      class="view-panel"
      role="tabpanel"
      aria-labelledby="category-view-tab-map"
      data-map-view-panel
      hidden
    >
      <LearningMap
        locale={locale}
        subject={subject.data.slug}
        category={`${subject.data.slug}/${category.slug}`}
      />
    </div>
      </section>
      <aside class="recent" aria-label={locale === "ja" ? "記事の更新情報" : "Article updates"}>
        <section aria-labelledby="category-recent-heading">
          <div class="section-title">
            <h2 id="category-recent-heading">{locale === "ja" ? "最近公開された記事" : "Recently published"}</h2>
          </div>
          {recentArticles.length > 0 ? (
            <div class="scroll-shell">
              <div class="recent-scroll" tabindex="0">
                <ul class="recent-list">
                  {recentArticles.map((article) => (
                    <li>
                      <a href={articlePath(locale, article.data.subject, article.data.category, article.data.slug)}>{article.data.title}</a>
                      <time datetime={article.data.updatedAt.toISOString()}>{article.data.updatedAt.toLocaleDateString(locale === "ja" ? "ja-JP" : "en-US")}</time>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ) : <p class="highlight-empty">{locale === "ja" ? "現在ありません。" : "Nothing yet."}</p>}
        </section>
        <section class="upcoming" aria-labelledby="category-upcoming-heading">
          <div class="section-title">
            <h2 id="category-upcoming-heading">{locale === "ja" ? "近日公開予定の記事" : "Coming soon"}</h2>
          </div>
          {planned.length > 0 ? (
            <ul class="upcoming-list" tabindex="0">
              {planned.slice(0, 6).map((item) => (
                <li>
                  <a href="#planned-articles">{plannedArticleTitle(item, locale)}</a>
                  <span class="upcoming-meta">
                    <span class="upcoming-category">{plannedProgress(item) === "in-progress" ? (locale === "ja" ? "準備中" : "In progress") : (locale === "ja" ? "予定" : "Planned")}</span>
                  </span>
                </li>
              ))}
            </ul>
          ) : <p class="highlight-empty">{locale === "ja" ? "現在ありません。" : "Nothing yet."}</p>}
        </section>
      </aside>
    </div>
  </div>
</AtlasLayout>

<style>
  .category-home {
    max-width: var(--content-width);
    padding-bottom: var(--space-5);
  }
  .view-bar {
    display: flex;
    align-items: flex-end;
    gap: var(--space-3);
    flex-wrap: wrap;
    margin-top: var(--space-4);
    border-bottom: 2px solid var(--accent-primary);
  }
  .view-tabs {
    display: flex;
    gap: 2px;
  }
  .view-tab {
    position: relative;
    bottom: -2px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--touch-target);
    padding: 0 var(--space-3);
    border: 1px solid var(--border-strong);
    border-bottom: 2px solid var(--accent-primary);
    border-radius: var(--radius) var(--radius) 0 0;
    background: var(--background-secondary);
    color: var(--text-secondary);
    font: inherit;
    font-size: calc(0.95rem * var(--text-scale));
    font-weight: 600;
    cursor: pointer;
  }
  .view-tab:hover {
    color: var(--accent-primary);
    border-color: var(--accent-primary);
  }
  .view-tab[aria-selected="true"] {
    border-color: var(--accent-primary);
    border-bottom-color: var(--background-primary);
    background: var(--background-primary);
    color: var(--accent-primary);
    font-weight: 700;
  }
  .section-meta {
    margin: 0;
    padding-bottom: var(--space-2);
    color: var(--text-secondary);
    font-size: calc(0.85rem * var(--text-scale));
  }
  .view-panel {
    padding-top: var(--space-3);
  }
  .view-panel > :global(.map-section) {
    margin-top: 0;
  }
  .article-collection {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .article-collection[data-view="grid"] {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: var(--space-3);
  }
  .article-title {
    font-size: calc(1.1rem * var(--text-scale));
    margin: 0;
  }
  .article-item {
    position: relative;
  }
  .article-title a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .article-item:has(.article-title a:hover),
  .article-item:has(.article-title a:focus-visible) {
    border-color: var(--accent-primary);
    box-shadow: 0 3px 12px rgb(0 0 0 / 0.14);
  }
  .article-summary {
    margin: 0;
    color: var(--text-secondary);
  }
  .planned-article {
    border-style: dashed;
    background: var(--background-secondary);
  }

  .content-columns { align-items: start; display: grid; gap: var(--space-5); grid-template-columns: minmax(0, 1fr) minmax(14rem, 16rem); padding-block: var(--space-2) var(--space-5); }
  .category-main { min-width: 0; }
  .section-title { align-items: baseline; border-bottom: 1px solid var(--border-strong); display: flex; gap: var(--space-3); padding-bottom: var(--space-1); }
  .section-title h2 { font-size: calc(1.02rem * var(--text-scale)); margin: 0; }
  .recent { font-size: calc(.9rem * var(--text-scale)); min-width: 0; }
  .recent-scroll { max-height: 26rem; overflow-y: auto; padding-right: var(--space-2); scrollbar-gutter: stable; }
  .scroll-shell { position: relative; }
  .recent-list, .upcoming-list { list-style: none; margin: 0; padding: 0; }
  .recent-list li, .upcoming-list li { align-items: baseline; border-bottom: 1px solid var(--border-default); display: flex; gap: var(--space-2); justify-content: space-between; line-height: 1.45; padding: var(--space-1) 0; }
  .recent-list a, .upcoming-list a { min-width: 0; overflow-wrap: anywhere; text-decoration: none; }
  .recent-list a:hover, .upcoming-list a:hover { text-decoration: underline; }
  .recent-list time, .upcoming-category { color: var(--text-secondary); flex: 0 0 auto; font-size: calc(.72rem * var(--text-scale)); }
  .upcoming { margin-top: var(--space-4); }
  .upcoming-list { max-height: 14rem; overflow-y: auto; padding-right: var(--space-2); scrollbar-gutter: stable; }
  .upcoming-list li { border-bottom-style: dashed; }
  .upcoming-meta { flex: 0 0 auto; }
  .highlight-empty { color: var(--text-secondary); font-size: calc(.8rem * var(--text-scale)); margin: 0; }
  .article-status {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    color: var(--accent-primary);
    font-size: calc(0.82rem * var(--text-scale));
    font-weight: 700;
  }
  .article-badges {
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
    align-items: center;
    margin: 0;
  }
  .article-prereqs {
    margin: 0;
    font-size: calc(0.85rem * var(--text-scale));
    color: var(--text-secondary);
  }
  /* リスト表示: 情報密度の高い一行表示 */
  .article-collection[data-view="list"] {
    display: flex;
    flex-direction: column;
  }
  .article-collection[data-view="list"] .article-item {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "title badges"
      "summary badges"
      "prereqs badges";
    gap: var(--space-1) var(--space-3);
    border: 0;
    border-bottom: 1px solid var(--border-default);
    border-radius: 0;
    padding: var(--space-2) var(--space-1);
  }
  .article-collection[data-view="list"] .article-title {
    grid-area: title;
  }
  .article-collection[data-view="list"] .article-summary {
    grid-area: summary;
    font-size: calc(0.9rem * var(--text-scale));
  }
  .article-collection[data-view="list"] .article-badges {
    grid-area: badges;
  }
  .article-collection[data-view="list"] .article-prereqs {
    grid-area: prereqs;
  }
  .article-item[hidden] {
    display: none;
  }
  @media (max-width: 767px) {
    .content-columns { grid-template-columns: 1fr; gap: var(--space-4); }
    .recent-scroll { max-height: 18rem; }
    .article-collection[data-view="list"] .article-item {
      grid-template-columns: 1fr;
      grid-template-areas: "title" "summary" "badges" "prereqs";
    }
    .view-tabs {
      width: 100%;
      border-bottom: 2px solid var(--accent-primary);
    }
    .view-bar {
      border-bottom: 0;
    }
    .view-tab {
      flex: 1 1 0;
      padding-inline: var(--space-1);
    }
    .section-meta {
      width: 100%;
      padding-top: var(--space-2);
      padding-bottom: 0;
    }
  }
</style>

<script>
  const categoryLayout = document.querySelector<HTMLElement>(
    "[data-category-layout]",
  );
  const collection = document.querySelector<HTMLElement>(
    ".article-collection",
  );
  const articlePanel = document.querySelector<HTMLElement>(
    "[data-article-view-panel]",
  );
  const mapPanel = document.querySelector<HTMLElement>("[data-map-view-panel]");
  const tabs = [
    ...document.querySelectorAll<HTMLButtonElement>(
      "[data-category-layout] [data-view-tab]",
    ),
  ];
  const viewKey =
    categoryLayout?.dataset.viewStorageKey ?? "atlasez-category-view";
  const contextSearchStatus = document.querySelector<HTMLElement>(
    "[data-context-search-status]",
  );
  const contextSearchItems = [
    ...document.querySelectorAll<HTMLElement>("[data-context-search-item]"),
  ];
  function applyContextSearch(rawQuery: string): void {
    const query = rawQuery.trim().toLocaleLowerCase();
    let visible = 0;
    for (const item of contextSearchItems) {
      const text = (item.dataset.searchText ?? item.textContent ?? "").toLocaleLowerCase();
      const show = !query || text.includes(query);
      item.hidden = !show;
      if (show) visible += 1;
    }
    if (contextSearchStatus) {
      contextSearchStatus.textContent = query ? `${visible}件を表示` : "";
    }
  }

  document.addEventListener("atlas:context-search", (event) => {
    const detail = (event as CustomEvent<{ view?: string; query?: string }>).detail;
    if (!detail?.view || detail.view === "map") return;
    applyContextSearch(detail.query ?? "");
  });

  function setView(view: string, focus = false): void {
    if (!tabs.some((tab) => tab.dataset.viewTab === view)) view = "tiles";
    const mapActive = view === "map";
    if (collection) collection.dataset.view = view === "list" ? "list" : "grid";
    if (articlePanel) {
      articlePanel.hidden = mapActive;
      articlePanel.setAttribute(
        "aria-labelledby",
        `category-view-tab-${view === "list" ? "list" : "tiles"}`,
      );
    }
    if (mapPanel) mapPanel.hidden = !mapActive;
    if (categoryLayout) categoryLayout.dataset.activeView = view;
    applyContextSearch("");
    window.dispatchEvent(new CustomEvent("atlas:view-change", { detail: { view } }));
    for (const tab of tabs) {
      const active = tab.dataset.viewTab === view;
      tab.setAttribute("aria-selected", String(active));
      if (active) tab.removeAttribute("tabindex");
      else tab.setAttribute("tabindex", "-1");
      if (active && focus) tab.focus();
    }
    try {
      localStorage.setItem(viewKey, view);
    } catch {
      /* 保存できなくても表示切り替えは利用できる */
    }
    const url = new URL(location.href);
    if (view === "tiles") url.searchParams.delete("view");
    else url.searchParams.set("view", view);
    history.replaceState(null, "", url);
    if (mapActive) window.dispatchEvent(new Event("resize"));
  }

  if (tabs.length > 0) {
    tabs.forEach((tab) =>
      tab.addEventListener("click", () => setView(tab.dataset.viewTab ?? "")),
    );
    document
      .querySelector<HTMLElement>("[data-category-layout] [data-view-tabs]")
      ?.addEventListener("keydown", (event) => {
        const keys = ["ArrowRight", "ArrowLeft", "Home", "End"];
        if (!keys.includes(event.key)) return;
        event.preventDefault();
        const index = tabs.findIndex(
          (tab) => tab.getAttribute("aria-selected") === "true",
        );
        const next =
          event.key === "Home"
            ? 0
            : event.key === "End"
              ? tabs.length - 1
              : (index +
                  (event.key === "ArrowRight" ? 1 : -1) +
                  tabs.length) %
                tabs.length;
        setView(tabs[next].dataset.viewTab ?? "", true);
      });

    let initial = new URL(location.href).searchParams.get("view");
    if (!initial) {
      try {
        initial = localStorage.getItem(viewKey);
      } catch {
        initial = null;
      }
    }
    setView(initial ?? "tiles");
  }

</script>
