    tasks.addEventListener('change', (event) => { const row = (event.target as HTMLElement).closest<HTMLElement>('[data-reminder-rule]'); if (row) syncReminderRule(row); });
    tasks.addEventListener('click', (event) => { const target = event.target as HTMLElement; const addButton = target.closest<HTMLButtonElement>('[data-add-reminder]'); if (addButton) { const editor = addButton.closest<HTMLElement>('[data-reminder-editor]'); const rules = editor?.querySelector<HTMLElement>('.task-reminder-rules'); if (!editor || !rules) return; editor.querySelector('[data-reminder-empty]')?.remove(); rules.insertAdjacentHTML('beforeend', reminderRowHtml()); const row = rules.lastElementChild as HTMLElement | null; if (row) syncReminderRule(row); return; } const removeButton = target.closest<HTMLButtonElement>('[data-remove-reminder]'); if (removeButton) { const editor = removeButton.closest<HTMLElement>('[data-reminder-editor]'); removeButton.closest('[data-reminder-rule]')?.remove(); if (editor && !editor.querySelector('[data-reminder-rule]')) editor.querySelector('.task-reminder-rules')?.insertAdjacentHTML('afterbegin', '<p data-reminder-empty>リマインダーは設定されていません。</p>'); return; } const saveButton = target.closest<HTMLButtonElement>('[data-save-reminders]'); if (!saveButton) return; const editor = saveButton.closest<HTMLElement>('[data-reminder-editor]'); if (!editor) return; const feedback = editor.querySelector<HTMLOutputElement>('[data-reminder-feedback]'); if (!feedback) return; const rows = [...editor.querySelectorAll<HTMLElement>('[data-reminder-rule]')]; const reminders = rows.map((row) => { const kind = row.querySelector<HTMLSelectElement>('[data-reminder-kind]')?.value ?? 'before_days'; const amount = Number(row.querySelector<HTMLInputElement>('[data-reminder-amount]')?.value ?? '0'); const start = row.querySelector<HTMLInputElement>('[data-reminder-start]')?.value || '09:00'; const timezone = row.querySelector<HTMLInputElement>('[data-reminder-timezone]')?.value ?? taskDueTimezone.value; const label = row.querySelector<HTMLInputElement>('[data-reminder-label]')?.value ?? ''; if (kind === 'before_days' || kind === 'before_hours') return amount > 0 ? { kind: 'before', amount, unit: kind === 'before_hours' ? 'hours' : 'days' } : null; if (kind === 'due_day_hourly') return { kind, start }; return { kind: 'absolute', remindAt: row.querySelector<HTMLInputElement>('[data-reminder-value]')?.value ?? '', timezone, label }; }).filter((reminder) => reminder !== null && (reminder.kind !== 'absolute' || Boolean(reminder.remindAt))); const repeat = editor.querySelector<HTMLInputElement>('[data-reminder-repeat]')?.value ?? 'none'; const reminderEmail = editor.querySelector<HTMLInputElement>('[data-reminder-email]')?.value ?? ''; saveButton.disabled = true; feedback.value = '保存中…'; void api(`/api/admin/operations/tasks/${encodeURIComponent(editor.dataset.reminderEditor ?? '')}`, 'PATCH', { reminderAction: 'replace', reminders, reminderRepeat: repeat, reminderEmail }).then(async () => { feedback.value = 'このToDoのリマインダーを保存しました。'; await load(); }).catch((error) => { const message = error instanceof Error ? error.message : 'リマインダーを保存できませんでした。'; feedback.value = message; showError(message); }).finally(() => { saveButton.disabled = false; }); });
    events.addEventListener('click', (event) => { const target = event.target as HTMLElement; const deleteButton = target.closest<HTMLButtonElement>('[data-delete-event]'); if (deleteButton) { if (!confirm('この日程と参加登録を削除しますか？')) return; deleteButton.disabled = true; eventFeedback.value = '日程を削除中…'; void api(`/api/admin/operations/events/${encodeURIComponent(deleteButton.dataset.deleteEvent ?? '')}`, 'DELETE').then(async () => { eventFeedback.value = '日程を削除しました。'; await load(); }).catch((error) => { const message = error instanceof Error ? error.message : '日程を削除できませんでした。'; eventFeedback.value = message; showError(message); }).finally(() => { deleteButton.disabled = false; }); return; } const button = target.closest<HTMLButtonElement>('[data-availability]'); if (!button) return; const eventItem = (data.events ?? []).find((item) => String(item.id) === String(button.dataset.event)); if (eventItem && eventItem.availability && eventItem.availability !== button.dataset.availability) addPrototypeHistory({ eventId: String(eventItem.id), message: `「${String(eventItem.title)}」の参加可否を${eventItem.availability}から${button.dataset.availability}へ変更`, previousAvailability: String(eventItem.availability), kind: 'event' }); button.disabled = true; eventFeedback.value = '参加状態を保存中…'; void api(`/api/admin/operations/events/${encodeURIComponent(button.dataset.event ?? '')}/availability`, 'PUT', { availability: button.dataset.availability }).then(async () => { eventFeedback.value = '参加状態を保存しました。'; await load(); }).catch((error) => { const message = error instanceof Error ? error.message : '参加状態を保存できませんでした。'; eventFeedback.value = message; showError(message); }).finally(() => { button.disabled = false; }); });
    get<HTMLButtonElement>('[data-add-unavailability]').addEventListener('click', (event) => { const button = event.currentTarget as HTMLButtonElement; const start = get<HTMLInputElement>('[data-unavailable-start]'); const end = get<HTMLInputElement>('[data-unavailable-end]'); const label = get<HTMLInputElement>('[data-unavailable-label]'); button.disabled = true; void api('/api/admin/operations/unavailability', 'POST', { startsAt: start.value, endsAt: end.value, timezone: get<HTMLSelectElement>('[data-unavailable-timezone]').value, label: label.value }).then(() => { start.value = ''; end.value = ''; label.value = ''; return load(); }).catch((error) => { showError(error instanceof Error ? error.message : '予定不可期間を保存できませんでした。'); }).finally(() => { button.disabled = false; }); });
    root.querySelector<HTMLElement>('[data-unavailability-list]')?.addEventListener('click', (event) => { const button = (event.target as HTMLElement).closest<HTMLButtonElement>('[data-delete-unavailability]'); if (!button) return; button.disabled = true; void api(`/api/admin/operations/unavailability/${encodeURIComponent(button.dataset.deleteUnavailability ?? '')}`, 'DELETE').then(load).catch((error) => showError(error instanceof Error ? error.message : '予定不可期間を削除できませんでした。')); });
    get<HTMLButtonElement>('[data-calendar-prev]').addEventListener('click', () => { month = new Date(month.getFullYear(), month.getMonth() - 1, 1); renderCalendar(); });
    get<HTMLButtonElement>('[data-calendar-next]').addEventListener('click', () => { month = new Date(month.getFullYear(), month.getMonth() + 1, 1); renderCalendar(); });
    timezone.addEventListener('change', () => { render(); });
    calendarSystem.addEventListener('change', () => { renderCalendar(); });
    holidayRegion.addEventListener('change', () => { renderCalendar(); void loadHolidays(); });
    renderCalendar();
    void load().catch((error) => { const message = error instanceof Error ? error.message : '進行管理を読み込めませんでした。'; tasks.innerHTML = `<p class="empty-state">${escapeHtml(message)}</p>`; events.innerHTML = `<p class="empty-state">${escapeHtml(message)}</p>`; reports.innerHTML = `<p class="empty-state">${escapeHtml(message)}</p>`; calendarTitle.textContent = '読み込めませんでした'; showError(message); });
  };
  document.addEventListener('astro:page-load', initializeOperations);
  initializeOperations();
