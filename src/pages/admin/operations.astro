---
import AdminLayout from "../../layouts/AdminLayout.astro";
import AdminNav from "../../components/AdminNav.astro";
import AdminErrorActions from "../../components/AdminErrorActions.astro";
import { getCollection } from "astro:content";
const subjects = (await getCollection("subjects")).sort((a, b) => a.data.order - b.data.order).map((subject) => ({ slug: subject.data.slug, name: subject.data.name.ja }));
const timezones = [
  ["Asia/Tokyo", "日本（東京）"], ["Asia/Seoul", "韓国（ソウル）"], ["Asia/Shanghai", "中国（上海）"], ["Asia/Taipei", "台湾（台北）"], ["Asia/Hong_Kong", "香港"], ["Asia/Singapore", "シンガポール"], ["Asia/Bangkok", "タイ（バンコク）"], ["Asia/Kolkata", "インド（コルカタ）"], ["Asia/Dubai", "アラブ首長国連邦（ドバイ）"], ["Australia/Sydney", "オーストラリア（シドニー）"], ["Pacific/Auckland", "ニュージーランド（オークランド）"], ["Europe/London", "英国（ロンドン）"], ["Europe/Paris", "フランス・中央ヨーロッパ"], ["Europe/Berlin", "ドイツ（ベルリン）"], ["Europe/Rome", "イタリア（ローマ）"], ["Europe/Madrid", "スペイン（マドリード）"], ["Europe/Moscow", "ロシア（モスクワ）"], ["Africa/Cairo", "エジプト（カイロ）"], ["Africa/Johannesburg", "南アフリカ（ヨハネスブルク）"], ["America/Sao_Paulo", "ブラジル（サンパウロ）"], ["America/New_York", "米国東部（ニューヨーク）"], ["America/Chicago", "米国中部（シカゴ）"], ["America/Denver", "米国山岳部（デンバー）"], ["America/Los_Angeles", "米国太平洋（ロサンゼルス）"], ["America/Anchorage", "米国アラスカ"], ["Pacific/Honolulu", "米国ハワイ"], ["America/Toronto", "カナダ（トロント）"], ["America/Vancouver", "カナダ（バンクーバー）"], ["America/Mexico_City", "メキシコ（メキシコシティ）"], ["UTC", "協定世界時（UTC）"],
] as const;
---
<AdminLayout title="進捗・ToDo・日程" description="運営作業を共有する場所">
<main id="admin-main" class="operations" data-operations><AdminNav current="operations" /><AdminErrorActions />
<header><h1>進捗・ToDo・日程</h1><span>作業を終えたら進捗を残し、次の作業と参加可能な日程を共有します。</span></header>
<aside class="prototype-lab" data-prototype-lab aria-labelledby="prototype-lab-title">
  <div class="prototype-lab-heading"><div><span class="prototype-badge">プロトタイプ</span><h2 id="prototype-lab-title">運営機能の試作エリア</h2><p>以下は今回追加した機能の試作です。既存データを補助的に扱い、設定・履歴はこのブラウザに保存されます。</p></div><button type="button" class="prototype-lab-toggle" data-prototype-toggle aria-expanded="false">展開する</button></div>
  <div class="prototype-lab-body" data-prototype-body hidden></div>
</aside>
<div class="grid">
<section><h2>進捗を報告</h2><p>編集・査読の完了後に、ここへ短く記録できます。</p><p class="discord-notice">記録すると、設定済みの分野Discordチャンネルと全体進捗チャンネルへ自動転送されます。</p><label class="field-label">進捗内容<textarea data-progress placeholder="例：群の定義を修正し、査読コメント3件に対応しました。"></textarea></label><button data-send-progress>進捗を記録してDiscordへ送る</button><output data-progress-feedback aria-live="polite"></output><h3 class="subheading">自分が投げた進捗報告</h3><div data-progress-list><p class="loading-state">読み込み中…</p></div></section>
<section><h2>ToDo</h2><p>自分の担当、または自分が依頼したタスクを優先して確認できます。</p><label class="field-label">並べ替え・絞り込み<select data-task-filter><option value="due">期限が近い順</option><option value="overdue">期限切れ</option><option value="today">今日まで</option><option value="created">自分が依頼</option><option value="assigned">自分が担当</option></select></label><input data-task-title placeholder="タスク名"/><label class="field-label">対象分野<select data-task-subject><option value="">全体</option>{subjects.map((subject) => <option value={subject.slug}>{subject.name}</option>)}</select></label><label class="field-label">担当者<select data-task-assignee><option value="">担当者を指定しない</option></select></label><div class="task-deadline"><label class="field-label">期限日時<input data-task-due type="datetime-local" /></label><label class="field-label">期限のタイムゾーン<select data-task-due-timezone>{timezones.map(([value, label]) => <option value={value} selected={value === "Asia/Tokyo"}>{label}</option>)}</select></label></div><section class="reminder-presets task-reminder-settings" aria-labelledby="reminder-presets-title"><h3 id="reminder-presets-title">自分用リマインダー</h3><p>期限を基準に「N日前」「N時間前」「当日毎時」で、必要な数だけ設定できます。当日毎時は指定した開始時刻から期限までです。メール欄を空欄にすると、運営サイト右上の通知ベルに表示します。</p><div class="task-reminder-list" data-task-reminder-list><div class="task-reminder-row" data-task-reminder-row><label class="field-label">種類<select data-task-reminder-kind><option value="before_days">N日前</option><option value="before_hours">N時間前</option><option value="due_day_hourly">当日毎時</option></select></label><label class="field-label" data-task-reminder-amount-label>数量<input data-task-reminder-amount type="number" min="1" max="8760" placeholder="N" /></label><label class="field-label" data-task-reminder-start-label hidden>開始時刻<input data-task-reminder-start type="time" value="09:00" /></label><button type="button" class="task-reminder-remove" data-remove-task-reminder hidden>削除</button></div></div><button type="button" data-add-task-reminder>リマインダーを追加</button><label class="field-label">自分の通知先メールアドレス（任意）<input data-task-reminder-email type="email" maxlength="254" placeholder="自分のメールアドレス" /></label></section><textarea data-task-details placeholder="補足・依頼内容（任意）"></textarea><button data-create-task>タスクを追加</button><output class="operation-feedback" data-task-feedback aria-live="polite"></output><div class="todo-view-switch" role="tablist" aria-label="ToDoの表示範囲"><button type="button" data-task-view="mine" aria-selected="true">自分がこなす</button><button type="button" data-task-view="all" aria-selected="false">すべて</button><button type="button" data-task-view="created" aria-selected="false">自分が依頼</button></div><div data-task-list aria-live="polite"><p class="loading-state">ToDoを読み込んでいます…</p></div></section>
<section class="wide" id="events"><h2>同時作業会・交流会の日程</h2><p>全分野管理者は日程を追加できます。各メンバーは「参加できる／未定／参加できない」を自分で登録します。</p><label class="field-label">表示するタイムゾーン<select data-calendar-timezone>{timezones.map(([value, label]) => <option value={value} selected={value === "Asia/Tokyo"}>{label}</option>)}</select></label><label class="field-label">暦表示<select data-calendar-system aria-label="暦表示"><option value="gregory">西暦（グレゴリオ暦）</option><option value="japanese">和暦（日本の元号）</option><option value="islamic">イスラム暦（表示のみ）</option></select></label><div class="calendar-head"><button type="button" data-calendar-prev aria-label="前の月">‹</button><strong data-calendar-title>読み込み中…</strong><button type="button" data-calendar-next aria-label="次の月">›</button></div><div class="calendar-week" data-event-calendar aria-label="日程カレンダー"><p class="loading-state">カレンダーを準備しています…</p></div><small class="calendar-note">祝日APIのデータを優先し、取得できない場合は内蔵の主要祝日を表示します。予定の保存形式はISO 8601（グレゴリオ暦）で、表示だけ暦を切り替えられます。</small><div class="event-create" data-event-create hidden><input data-event-title placeholder="催し名"/><input data-event-start type="datetime-local" aria-label="開始日時"/><input data-event-end type="datetime-local" aria-label="終了日時"/><select data-event-timezone aria-label="日程の基準タイムゾーン">{timezones.map(([value, label]) => <option value={value} selected={value === "Asia/Tokyo"}>{label}</option>)}</select><button data-create-event>日程を追加</button></div><output class="operation-feedback" data-event-feedback aria-live="polite"></output><div data-event-list aria-live="polite"><p class="loading-state">日程を読み込んでいます…</p></div></section>
</div><section class="wide availability-panel" aria-labelledby="unavailability-title"><h2 id="unavailability-title">自分の予定不可期間</h2><p>試験期間、休暇、一時滞在など、動けない期間をメンバー向けに登録できます。</p><div class="unavailability-form"><label class="field-label">開始日時<input data-unavailable-start type="datetime-local" /></label><label class="field-label">終了日時<input data-unavailable-end type="datetime-local" /></label><label class="field-label">タイムゾーン<select data-unavailable-timezone>{timezones.map(([value, label]) => <option value={value} selected={value === "Asia/Tokyo"}>{label}</option>)}</select></label><label class="field-label">理由（任意）<input data-unavailable-label placeholder="例：試験期間" /></label><button type="button" data-add-unavailability>登録</button></div><div data-unavailability-list><p class="loading-state">読み込み中…</p></div></section></main>
</AdminLayout>
<style is:global>
  .operations{box-sizing:border-box;margin:0 auto;max-width:1200px;padding:0 1.25rem 4rem}.operations > header{border-bottom:1px solid var(--border-default);padding:2rem 0 1.25rem}.operations > header p{color:var(--accent-primary);font-size:.76rem;font-weight:800;letter-spacing:.08em;margin:0}.operations h1{font-size:2rem;margin:.25rem 0}.operations > header span,.operations section>p{color:var(--text-secondary);line-height:1.6}.grid{display:grid;gap:1rem;grid-template-columns:1fr 1fr;margin-top:1.25rem}.grid section{border:1px solid var(--border-default);min-width:0;padding:1rem}.grid h2{font-size:1.1rem;margin:0}.grid section>p{font-size:.82rem;margin:.4rem 0 .8rem}.wide{grid-column:span 2}.operations input,.operations textarea{background:var(--background-primary);border:1px solid var(--border-default);box-sizing:border-box;color:var(--text-primary);font:inherit;margin:.25rem 0;padding:.55rem;width:100%}.operations textarea{min-height:6rem;resize:vertical}.operations button{background:var(--accent-primary);border:1px solid var(--accent-primary);color:#fff;cursor:pointer;font:inherit;font-size:.82rem;font-weight:800;margin-top:.35rem;padding:.5rem .7rem}.item{border-top:1px solid var(--border-default);display:grid;gap:.3rem;margin-top:.85rem;padding:.7rem 0}.item small{color:var(--text-secondary)}.task-row{align-items:center;display:flex;gap:.5rem;justify-content:space-between}.task-row select{font:inherit;padding:.25rem}.event-create{display:grid;gap:.35rem;grid-template-columns:1fr 1fr 1fr auto}.event-create[hidden]{display:none!important}.availability{display:flex;flex-wrap:wrap;gap:.35rem}.availability button{background:var(--background-secondary);border-color:var(--border-default);color:var(--text-primary)}.availability button:hover{border-color:var(--accent-primary);color:var(--accent-primary)}.loading-state,.empty-state{color:var(--text-secondary);font-size:.78rem;margin:.7rem 0;padding:.4rem 0}.empty-state{border:1px dashed var(--border-default);padding:.8rem;text-align:center}@media(max-width:700px){.operations{padding:0 .8rem 3rem}.operations > header{align-items:start;display:block}.operations h1{font-size:clamp(1.6rem,8vw,2rem)}.grid{grid-template-columns:1fr}.wide{grid-column:auto}.event-create{grid-template-columns:1fr}.task-row{align-items:start;display:grid}.calendar-cell{min-width:0}.calendar-event{font-size:.56rem;line-height:1.25;padding:.12rem .16rem}}
  .calendar-head{align-items:center;display:flex;justify-content:center;gap:.7rem;margin:1rem 0 .55rem}.calendar-head button{font-size:1.2rem;line-height:1;margin:0;min-width:2.2rem}.calendar-week{display:grid;gap:1px;grid-template-columns:repeat(7,minmax(0,1fr));background:var(--border-default);border:1px solid var(--border-default)}.calendar-cell{background:var(--background-primary);min-height:6.8rem;padding:.35rem}.calendar-cell--blank{background:var(--background-secondary)}.calendar-day{color:var(--text-secondary);font-size:.7rem;font-weight:800}.calendar-event{background:color-mix(in srgb,var(--accent-primary) 13%,var(--background-primary));border-left:2px solid var(--accent-primary);display:block;font-size:.67rem;line-height:1.35;margin-top:.25rem;overflow:hidden;padding:.15rem .25rem;text-overflow:ellipsis;white-space:nowrap}.calendar-note{color:var(--text-secondary);display:block;font-size:.72rem;margin-top:.5rem}.event-create{grid-template-columns:1fr 1fr 1fr minmax(125px,.7fr) auto}@media(max-width:700px){.calendar-cell{min-height:4.6rem;padding:.25rem}.calendar-event{font-size:.58rem}.event-create{grid-template-columns:1fr}}
  .calendar-cell--holiday{background:color-mix(in srgb,#d9485f 8%,var(--background-primary))}.calendar-holiday{color:#b33649;display:block;font-size:.61rem;font-weight:800;line-height:1.25;margin-top:.15rem;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.task-deadline{display:grid;gap:.55rem;grid-template-columns:1fr 1fr}.task-deadline input,.task-deadline select{margin:.25rem 0}@media(max-width:700px){.task-deadline{grid-template-columns:1fr}}
  .event-heading{align-items:center;display:flex;gap:.6rem;justify-content:space-between}
  .event-delete{background:transparent!important;border-color:var(--border-default)!important;color:var(--text-secondary)!important;font-size:.72rem!important;font-weight:700!important;margin:0!important;padding:.3rem .5rem!important}
  .event-delete:hover{border-color:var(--accent-primary)!important;color:var(--accent-primary)!important}
</style>
<style is:global>
  /* 日程入力はタイトルを十分に確保し、追加ボタンが入力欄の高さに引き伸ばされないようにする。 */
  .event-create {
    align-items: center;
    gap: .5rem;
    grid-template-columns: minmax(14rem, 1.6fr) minmax(12rem, 1fr) minmax(12rem, 1fr) minmax(11rem, .9fr) auto;
  }
  .event-create input,
  .event-create select { margin: 0; min-width: 0; }
  .event-create button { align-self: center; margin: 0; min-height: 2.35rem; white-space: nowrap; }
  @media (max-width: 900px) {
    .event-create { grid-template-columns: 1fr; }
    .event-create button { justify-self: start; }
  }

  .participant-summary { border-top: 1px solid var(--border-default); display: grid; gap: .45rem; margin-top: .55rem; padding-top: .55rem; }
  .participant-counts, .participant-names { display: flex; flex-wrap: wrap; gap: .35rem; }
  .participant-counts span, .participant-chip { border: 1px solid var(--border-default); border-radius: 999px; color: var(--text-secondary); font-size: .72rem; padding: .2rem .45rem; }
  .participant-chip { color: var(--text-primary); }
  .participant-available { background: #e4f5ea; border-color: #9bc9a9; }
  .participant-maybe { background: #fff4d6; border-color: #e5c879; }
  .participant-unavailable { background: #f5e5e7; border-color: #d8a4ad; }
</style>
<style>.discord-notice{background:color-mix(in srgb,var(--accent-primary),transparent 90%);border-left:3px solid var(--accent-primary);font-size:.8rem!important;font-weight:700;padding:.55rem .7rem}</style>
<style>.field-label{color:var(--text-secondary);display:grid;font-size:.76rem;font-weight:800;gap:.15rem}.operations select{background:var(--background-primary);border:1px solid var(--border-default);box-sizing:border-box;color:var(--text-primary);font:inherit;margin:.25rem 0;padding:.55rem;width:100%}.operation-feedback{color:var(--text-secondary);display:block;font-size:.76rem;min-height:1.2rem;padding-top:.35rem}.operations button:disabled{cursor:wait;opacity:.62}</style>
<style>.availability button.is-selected{background:var(--accent-primary);border-color:var(--accent-primary);color:#fff;box-shadow:0 0 0 2px color-mix(in srgb,var(--accent-primary),transparent 75%)}.availability button[aria-pressed="true"]{font-weight:900}</style>
<style>.subheading{border-top:1px solid var(--border-default);font-size:.82rem;margin:1rem 0 0;padding-top:.75rem}.todo-view-switch{display:flex;gap:.35rem;margin:.7rem 0}.todo-view-switch button{background:var(--background-secondary);border-color:var(--border-default);color:var(--text-primary);font-size:.76rem;margin:0}.todo-view-switch button[aria-selected="true"]{background:var(--accent-primary);border-color:var(--accent-primary);color:#fff}.task-role{background:color-mix(in srgb,var(--accent-primary),transparent 88%);border-radius:999px;color:var(--accent-primary);font-weight:800;padding:.12rem .35rem}.task-reminder{display:grid;gap:.55rem;grid-template-columns:1fr 1fr}.task-reminder input,.task-reminder select{margin:.25rem 0}@media(max-width:700px){.task-reminder{grid-template-columns:1fr}}</style>
<style>.reminder-presets{background:color-mix(in srgb,var(--accent-primary),transparent 94%)}.reminder-options{display:flex;flex-wrap:wrap;gap:.5rem}.reminder-options label{align-items:center;background:var(--background-primary);border:1px solid var(--border-default);border-radius:.4rem;display:flex;flex:0 0 auto;gap:.35rem;padding:.45rem .6rem;white-space:nowrap}.reminder-options label input[type="checkbox"]{flex:0 0 auto;height:1.1rem;margin:0;min-height:1.1rem;min-width:1.1rem;padding:0;width:1.1rem}.task-reminder-settings{border:1px solid var(--border-default);margin:.8rem 0;padding:.75rem}.task-reminder-settings h3{font-size:.9rem;margin:0}.task-reminder-settings>p{font-size:.76rem!important}.task-reminder-editor{border-top:1px solid var(--border-default);margin-top:.7rem;padding-top:.55rem}.task-reminder-editor summary{color:var(--accent-primary);cursor:pointer;font-size:.78rem;font-weight:800}.reminder-editor-note{color:var(--text-secondary);font-size:.72rem;margin:.45rem 0}.task-reminder-rules{display:grid;gap:.45rem}.task-reminder-rule{align-items:end;border-top:1px solid var(--border-default);display:grid;gap:.35rem;grid-template-columns:1.15fr 1fr 1fr auto;padding-top:.45rem}.task-reminder-rule input,.task-reminder-rule select{margin:0}.task-reminder-remove{background:transparent!important;border-color:var(--border-default)!important;color:var(--text-secondary)!important;font-size:.72rem!important;margin:0!important;padding:.45rem .55rem!important}.task-reminder-editor-actions{align-items:end;display:flex;flex-wrap:wrap;gap:.45rem;margin-top:.55rem}.task-reminder-editor-actions .field-label{flex:1 1 14rem}.task-reminder-editor-actions button{margin:0}.availability-panel{border-top:3px solid var(--accent-primary);margin-top:1rem}.unavailability-form{display:grid;gap:.45rem;grid-template-columns:1fr 1fr 1fr 1fr auto}.unavailability-form input,.unavailability-form select{margin:0}@media(max-width:700px){.unavailability-form{grid-template-columns:1fr}.task-reminder-rule{grid-template-columns:1fr}.task-reminder-editor-actions{display:grid}.task-reminder-editor-actions .field-label{min-width:0}}</style>
<style>.reminder-presets{background:color-mix(in srgb,var(--accent-primary),transparent 94%)}.reminder-options{display:flex;flex-wrap:wrap;gap:.5rem}.reminder-options label{align-items:center;background:var(--background-primary);border:1px solid var(--border-default);border-radius:.4rem;display:flex;flex:0 0 auto;gap:.35rem;padding:.45rem .6rem;white-space:nowrap}.reminder-options label input[type="checkbox"]{flex:0 0 auto;height:1.1rem;margin:0;min-height:1.1rem;min-width:1.1rem;padding:0;width:1.1rem}.task-reminder-settings{border:1px solid var(--border-default);margin:.8rem 0;padding:.75rem}.task-reminder-settings h3{font-size:.9rem;margin:0}.task-reminder-settings>p{font-size:.76rem!important}.reminder-custom-row{align-items:end;display:grid;gap:.45rem;grid-template-columns:1fr 1fr auto;margin-top:.65rem}.reminder-custom-row button{margin:0}.task-reminder-editor{border-top:1px solid var(--border-default);margin-top:.7rem;padding-top:.55rem}.task-reminder-editor summary{color:var(--accent-primary);cursor:pointer;font-size:.78rem;font-weight:800}.reminder-editor-note{color:var(--text-secondary);font-size:.72rem;margin:.45rem 0}.task-reminder-rules{display:grid;gap:.45rem}.task-reminder-rule{align-items:end;border-top:1px solid var(--border-default);display:grid;gap:.35rem;grid-template-columns:1.15fr 1fr 1fr auto;padding-top:.45rem}.task-reminder-rule input,.task-reminder-rule select{margin:0}.task-reminder-remove{background:transparent!important;border-color:var(--border-default)!important;color:var(--text-secondary)!important;font-size:.72rem!important;margin:0!important;padding:.45rem .55rem!important}.task-reminder-editor-actions{align-items:end;display:flex;flex-wrap:wrap;gap:.45rem;margin-top:.55rem}.task-reminder-editor-actions .field-label{flex:1 1 14rem}.task-reminder-editor-actions button{margin:0}.availability-panel{border-top:3px solid var(--accent-primary);margin-top:1rem}.unavailability-form{display:grid;gap:.45rem;grid-template-columns:1fr 1fr 1fr 1fr auto}.unavailability-form input,.unavailability-form select{margin:0}@media(max-width:700px){.unavailability-form{grid-template-columns:1fr}.reminder-custom-row{grid-template-columns:1fr 1fr}.reminder-custom-row button{grid-column:span 2}.task-reminder-rule{grid-template-columns:1fr}.task-reminder-editor-actions{display:grid}.task-reminder-editor-actions .field-label{min-width:0}}</style>
<style>.task-feedback{color:var(--text-secondary);display:grid;font-size:.72rem;gap:.45rem;margin-top:.35rem}.task-feedback-groups{display:flex;flex-wrap:wrap;gap:.75rem}.task-feedback-group{display:grid;gap:.15rem}.task-feedback-group b{color:var(--text-primary);font-size:.7rem}.task-feedback-group ul{display:flex;flex-wrap:wrap;gap:.2rem .45rem;list-style:none;margin:0;padding:0}.task-feedback-group li::before{content:'・';}.task-feedback-group>span{color:var(--text-secondary)}.task-feedback-actions{display:flex;flex-wrap:wrap;gap:.35rem}.task-feedback button{background:transparent;border-color:var(--border-default);color:var(--text-primary);font-size:.7rem;margin:0;padding:.25rem .45rem}.task-feedback button:hover{border-color:var(--accent-primary);color:var(--accent-primary)}.task-feedback .task-unreflected{color:#9a3535}.progress-details{white-space:pre-wrap}</style>
<style is:global>
  .availability { gap: .6rem; margin-top: .45rem; }
  .availability button { border-radius: .55rem; font-size: .9rem; min-height: 2.8rem; min-width: 8.5rem; padding: .65rem .9rem; }
  .availability button.is-selected { box-shadow: 0 0 0 3px color-mix(in srgb,var(--accent-primary),transparent 78%); }
  @media (max-width: 700px) { .availability { display: grid; grid-template-columns: 1fr; } .availability button { width: 100%; } }
</style>
<style is:global>
  .task-reminder-list { display: grid; gap: .45rem; }
  .task-reminder-row { align-items: end; display: grid; gap: .45rem; grid-template-columns: 1.3fr .7fr .9fr auto; }
  .task-reminder-row .field-label { min-width: 0; }
  .task-reminder-row .task-reminder-remove { margin: 0 0 .25rem; }
  @media (max-width: 700px) { .task-reminder-row { grid-template-columns: 1fr; } .task-reminder-row .task-reminder-remove { margin: 0; } }
</style>
<style is="global">
  .task-summary { display:grid; gap:.45rem; grid-template-columns:repeat(4,minmax(0,1fr)); margin:.75rem 0 1rem; }
  .operations .task-summary button { align-items:flex-start; background:var(--background-primary) !important; border:1px solid var(--border-default); border-radius:.55rem; color:var(--text-primary) !important; display:grid; gap:.12rem; margin:0; padding:.55rem .6rem; text-align:left; }
  .task-summary button:hover,.task-summary button:focus-visible { border-color:var(--accent-primary); color:var(--accent-primary); }
  .task-summary b { font-size:1.2rem; line-height:1; }
  .task-summary span { color:var(--text-secondary); font-size:.68rem; font-weight:800; }
  .task-reminder-destination { color:var(--text-secondary); display:block; font-size:.7rem; margin-top:.18rem; }
  .timezone-search { margin:.25rem 0 0; width:100%; }
  @media(max-width:700px){.task-summary{grid-template-columns:repeat(2,minmax(0,1fr));}}
</style>
<style>
  .task-reminder-settings.is-collapsed>p,.task-reminder-settings.is-collapsed>[data-task-reminder-list],.task-reminder-settings.is-collapsed>[data-add-task-reminder],.task-reminder-settings.is-collapsed>.field-label{display:none}
  .task-reminder-toggle{background:var(--background-secondary)!important;border-color:var(--border-default)!important;color:var(--text-primary)!important;font-size:.74rem!important;margin:.45rem 0!important;padding:.4rem .55rem!important}
  .task-reminder-delivery-note{font-size:.72rem!important;line-height:1.5;margin:.45rem 0 0!important}
</style>
<style is:global>
  .task-create-panel{border:1px solid var(--border-default);margin:.8rem 0;padding:.7rem .8rem}
  .task-create-panel>summary{color:var(--accent-primary);cursor:pointer;font-size:.85rem;font-weight:900}
  .task-create-panel[open]>summary{border-bottom:1px solid var(--border-default);margin-bottom:.7rem;padding-bottom:.55rem}
  .task-create-panel>.task-reminder-settings{margin:.7rem 0}
  .task-summary button[aria-pressed="true"]{background:var(--accent-primary)!important;border-color:var(--accent-primary);color:#fff!important}
  .task-completed-toggle{background:transparent!important;border-color:var(--border-default)!important;color:var(--text-secondary)!important;font-size:.72rem!important;margin:.45rem 0 0!important;padding:.35rem .5rem!important}
  .data-limit-note{color:var(--text-secondary);font-size:.72rem;margin:.35rem 0}
  .holiday-status{color:var(--text-secondary);display:block;font-size:.7rem;margin:.25rem 0}
  .event-details-inline{border-left:2px solid var(--border-default);color:var(--text-secondary);display:block;padding-left:.5rem;white-space:pre-wrap}
  .event-manage-link{color:var(--accent-primary);display:inline-block;font-size:.78rem;font-weight:800;margin:.5rem 0}
  .event-create .field-label{min-width:0}
  .event-create .event-details-field{grid-column:1 / span 4}
  .event-create .event-details-field textarea{margin:0;min-height:4rem}
  @media(max-width:900px){.event-create .event-details-field{grid-column:auto}}
  .prototype-lab{background:color-mix(in srgb,var(--accent-primary) 5%,var(--background-primary));border:1px solid color-mix(in srgb,var(--accent-primary) 35%,var(--border-default));margin:1rem 0;padding:1rem}
  .prototype-lab-heading{align-items:start;display:flex;gap:1rem;justify-content:space-between}.prototype-lab-heading h2{font-size:1rem;margin:.35rem 0}.prototype-lab-heading p{color:var(--text-secondary);font-size:.75rem;line-height:1.55;margin:.2rem 0 0}.prototype-badge{background:#fff1c7;border:1px solid #dfbd62;border-radius:999px;color:#6d4c00;display:inline-block;font-size:.65rem;font-weight:900;padding:.16rem .45rem}.prototype-lab-toggle{background:var(--background-primary)!important;border-color:var(--border-default)!important;color:var(--text-primary)!important;font-size:.72rem!important;margin:0!important;white-space:nowrap}.prototype-lab-body{border-top:1px solid var(--border-default);display:grid;gap:.75rem;grid-template-columns:repeat(2,minmax(0,1fr));margin-top:.8rem;padding-top:.8rem}.prototype-card{background:var(--background-primary);border:1px solid var(--border-default);padding:.75rem}.prototype-card h3{font-size:.85rem;margin:0}.prototype-card p{color:var(--text-secondary);font-size:.72rem;line-height:1.5;margin:.35rem 0}.prototype-card button{font-size:.72rem;margin:.25rem .25rem 0 0;padding:.4rem .55rem}.prototype-card select,.prototype-card input{background:var(--background-primary);border:1px solid var(--border-default);box-sizing:border-box;color:var(--text-primary);font:inherit;font-size:.75rem;margin:.2rem 0;padding:.4rem;width:100%}.prototype-card label{color:var(--text-secondary);display:grid;font-size:.7rem;font-weight:800;gap:.1rem}.prototype-actions{display:flex;flex-wrap:wrap;gap:.35rem}.prototype-output{color:var(--text-secondary);font-size:.72rem;line-height:1.5;margin-top:.45rem;white-space:pre-wrap}.prototype-history{display:grid;gap:.3rem;list-style:none;margin:.5rem 0 0;padding:0}.prototype-history li{border-top:1px solid var(--border-default);font-size:.7rem;padding-top:.35rem}.prototype-progress{background:var(--background-secondary);height:.45rem;overflow:hidden}.prototype-progress span{background:var(--accent-primary);display:block;height:100%}.prototype-bulk{align-items:end;background:var(--background-secondary);border:1px solid var(--border-default);display:grid;gap:.45rem;grid-template-columns:minmax(8rem,1fr) auto;margin:.6rem 0;padding:.55rem}.prototype-bulk label{color:var(--text-secondary);display:grid;font-size:.7rem;font-weight:800;gap:.15rem}.prototype-bulk select{background:var(--background-primary);border:1px solid var(--border-default);color:var(--text-primary);font:inherit;padding:.4rem}.task-select{accent-color:var(--accent-primary);height:1rem;margin:0!important;width:1rem!important}.task-select-wrap{align-items:center;display:flex;gap:.4rem}.task-blocked{background:#f8e5e5;border:1px solid #dba7a7;border-radius:999px;color:#873c3c;font-size:.65rem;font-weight:800;padding:.14rem .35rem}.task-dependency{border-top:1px solid var(--border-default);display:grid;gap:.35rem;margin-top:.45rem;padding-top:.45rem}.task-dependency select{font-size:.72rem;margin:0;padding:.35rem}.prototype-inline-note{color:var(--text-secondary);font-size:.68rem}.prototype-lab-body[hidden]{display:none}@media(max-width:800px){.prototype-lab-body{grid-template-columns:1fr}.prototype-lab-heading{display:grid}.prototype-lab-toggle{justify-self:start}.prototype-bulk{grid-template-columns:1fr}}
</style>
<script>
  type OperationMember = { email: string; display_name?: string };
  type OperationEvent = { id: string; title: string; details?: string | null; starts_at: string; ends_at?: string | null; timezone?: string | null; availability?: string | null; availabilityCounts?: Record<string, number>; participants?: Array<{ displayName: string; availability: string; isSelf: boolean }> };
  type OperationData = { scope: { email?: string; isManager: boolean }; tasks?: Array<Record<string, any>>; tasksTruncated?: boolean; events?: OperationEvent[]; eventsTruncated?: boolean; progress?: Array<Record<string, any>>; members?: OperationMember[]; unavailability?: Array<{ id: string; starts_at: string; ends_at: string; timezone: string; label?: string }>; reminderEmailDelivery?: { configured?: boolean; senderConfigured?: boolean } };
  const initializeOperations = () => {
    const root = document.querySelector<HTMLElement>('[data-operations]');
    if (!root || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';
    const taskViewSwitch = root.querySelector<HTMLElement>('.todo-view-switch');
    if (taskViewSwitch) {
      taskViewSwitch.innerHTML = '<button type="button" data-task-view="assigned" aria-selected="true">自分がこなす</button><button type="button" data-task-view="created" aria-selected="false">自分が依頼</button><button type="button" data-task-view="all" aria-selected="false">すべて</button>';
    }
    const get = <T extends Element>(selector: string) => root.querySelector<T>(selector)!;
    const prototypeBody = get<HTMLElement>('[data-prototype-body]');
    const prototypeToggle = get<HTMLButtonElement>('[data-prototype-toggle]');
    prototypeBody.hidden = true;
    prototypeToggle.textContent = '展開する';
    prototypeToggle.setAttribute('aria-expanded', 'false');
    const prototypeKey = 'atlasez.operations.prototype.v1';
    type PrototypeState = { reminderHistory?: Array<Record<string, string>>; dependencies?: Record<string, string[]>; history?: Array<Record<string, string>>; savedFilters?: Array<{ name: string; view: string; filter: string }> };
    const readPrototypeState = (): PrototypeState => { try { return JSON.parse(localStorage.getItem(prototypeKey) || '{}') as PrototypeState; } catch { return {}; } };
    const writePrototypeState = (state: PrototypeState) => { try { localStorage.setItem(prototypeKey, JSON.stringify(state)); } catch { /* 保存できない環境でも画面は利用できる */ } };
    const prototypeState = () => { const state = readPrototypeState(); state.reminderHistory ??= []; state.dependencies ??= {}; state.history ??= []; state.savedFilters ??= []; return state; };
    const prototypeBadge = '<span class="prototype-badge">プロトタイプ</span>';
    const googleCalendarUrl = (event: OperationEvent) => { const compact = (value: string) => value.replace(/[-:]/g, '').slice(0, 15) + '00'; const start = compact(event.starts_at); const end = event.ends_at ? compact(event.ends_at) : compact(event.starts_at); const params = new URLSearchParams({ action: 'TEMPLATE', text: event.title, dates: `${start}/${end}`, details: event.details || '', ctz: event.timezone || 'Asia/Tokyo' }); return `https://calendar.google.com/calendar/render?${params.toString()}`; };
    const icsDate = (value: string) => value.replace(/[-:]/g, '').slice(0, 15) + '00';
    const downloadIcs = () => { const lines = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//Atlasez//Operations Prototype//JP']; for (const event of data.events ?? []) lines.push('BEGIN:VEVENT', `UID:${event.id}@atlasez`, `DTSTAMP:${new Date().toISOString().replace(/[-:]/g, '').replace(/\.\d{3}Z$/, 'Z')}`, `DTSTART;TZID=${event.timezone || 'Asia/Tokyo'}:${icsDate(event.starts_at)}`, event.ends_at ? `DTEND;TZID=${event.timezone || 'Asia/Tokyo'}:${icsDate(event.ends_at)}` : '', `SUMMARY:${String(event.title).replace(/[\\,;\n]/g, ' ')}`, event.details ? `DESCRIPTION:${String(event.details).replace(/[\\,;\n]/g, ' ')}` : '', 'END:VEVENT'); const blob = new Blob([[...lines, 'END:VCALENDAR'].filter(Boolean).join('\r\n')], { type: 'text/calendar;charset=utf-8' }); const link = document.createElement('a'); link.href = URL.createObjectURL(blob); link.download = 'atlasez-events-prototype.ics'; link.click(); setTimeout(() => URL.revokeObjectURL(link.href), 0); };
    prototypeToggle.addEventListener('click', () => { const body = get<HTMLElement>('[data-prototype-body]'); const collapsed = body.hasAttribute('hidden'); body.toggleAttribute('hidden', !collapsed); prototypeToggle.textContent = collapsed ? '折りたたむ' : '展開する'; prototypeToggle.setAttribute('aria-expanded', String(collapsed)); });
    const progress = get<HTMLTextAreaElement>('[data-progress]');
    const tasks = get<HTMLElement>('[data-task-list]');
    const events = get<HTMLElement>('[data-event-list]');
    const reports = get<HTMLElement>('[data-progress-list]');
    const assignee = get<HTMLSelectElement>('[data-task-assignee]');
    const taskFilter = get<HTMLSelectElement>('[data-task-filter]');
    taskFilter.querySelectorAll('option[value="created"], option[value="assigned"]').forEach((option) => option.remove());
    const taskSummary = document.createElement('div');
    taskSummary.className = 'task-summary';
    taskSummary.dataset.taskSummary = '';
    taskSummary.setAttribute('aria-label', 'ToDoの件数');
    taskSummary.innerHTML = '<button type="button" data-task-summary-view="assigned"><b data-task-summary-assigned>0</b><span>自分がこなす</span></button><button type="button" data-task-summary-view="created"><b data-task-summary-created>0</b><span>自分が依頼</span></button><button type="button" data-task-summary-view="all"><b data-task-summary-all>0</b><span>未完了すべて</span></button><button type="button" data-task-summary-filter="overdue"><b data-task-summary-overdue>0</b><span>期限切れ</span></button>';
    taskFilter.closest('label')?.insertAdjacentElement('beforebegin', taskSummary);
    taskFilter.closest('label')?.setAttribute('hidden', '');
    const taskCompletedToggle = document.createElement('button');
    taskCompletedToggle.type = 'button';
    taskCompletedToggle.className = 'task-completed-toggle';
    taskSummary.insertAdjacentElement('afterend', taskCompletedToggle);
    const taskLimitNote = document.createElement('p');
    taskLimitNote.className = 'data-limit-note';
    taskLimitNote.hidden = true;
    taskCompletedToggle.insertAdjacentElement('afterend', taskLimitNote);
    const bulkBar = document.createElement('div');
    bulkBar.className = 'prototype-bulk';
    bulkBar.innerHTML = `${prototypeBadge}<label>選択したToDoの状態<select data-prototype-bulk-status><option value="">変更しない</option><option value="open">未着手</option><option value="doing">進行中</option><option value="done">完了</option></select></label><button type="button" data-prototype-bulk-apply>一括変更</button>`;
    tasks.insertAdjacentElement('beforebegin', bulkBar);
    const eventLimitNote = document.createElement('p');
    eventLimitNote.className = 'data-limit-note';
    eventLimitNote.hidden = true;
    events.insertAdjacentElement('beforebegin', eventLimitNote);
    const calendar = get<HTMLElement>('[data-event-calendar]');
    const calendarTitle = get<HTMLElement>('[data-calendar-title]');
    const timezone = get<HTMLSelectElement>('[data-calendar-timezone]');
    const calendarSystem = get<HTMLSelectElement>('[data-calendar-system]');
    const holidayRegion = document.createElement('select');
    holidayRegion.setAttribute('aria-label', '祝日地域');
    holidayRegion.innerHTML = '<option value="Asia/Tokyo">祝日：日本</option><option value="Asia/Seoul">祝日：韓国</option><option value="Asia/Taipei">祝日：台湾</option><option value="America/New_York">祝日：米国東部</option><option value="Europe/London">祝日：英国</option><option value="Europe/Paris">祝日：フランス・中央欧州</option><option value="none">祝日を表示しない</option>';
    const holidayField = document.createElement('label');
    holidayField.className = 'field-label';
    holidayField.append('祝日地域', holidayRegion);
    const timezoneField = timezone.closest('label');
    if (timezoneField) timezoneField.insertAdjacentElement('afterend', holidayField);
    else timezone.insertAdjacentElement('afterend', holidayField);
    const holidayStatus = document.createElement('small');
    holidayStatus.className = 'holiday-status';
    holidayField.insertAdjacentElement('afterend', holidayStatus);
    const additionalTimezones: Array<[string, string]> = [['Asia/Kathmandu', 'ネパール（カトマンズ）'], ['Asia/Yangon', 'ミャンマー（ヤンゴン）'], ['Asia/Almaty', 'カザフスタン（アルマトイ）'], ['Asia/Jerusalem', 'イスラエル（エルサレム）'], ['Europe/Helsinki', 'フィンランド（ヘルシンキ）'], ['Europe/Athens', 'ギリシャ（アテネ）'], ['America/St_Johns', 'カナダ（ニューファンドランド）'], ['America/Argentina/Buenos_Aires', 'アルゼンチン（ブエノスアイレス）'], ['Pacific/Chatham', 'ニュージーランド（チャタム諸島）'], ['Pacific/Guam', 'グアム']];
    const supportedTimezones = 'supportedValuesOf' in Intl ? (Intl as typeof Intl & { supportedValuesOf: (key: string) => string[] }).supportedValuesOf('timeZone') : [];
    const timezoneOptions = [...additionalTimezones, ...supportedTimezones.filter((value) => value !== 'UTC').map((value) => [value, value.replaceAll('_', ' ')] as [string, string]), ['UTC', '協定世界時（UTC）'] as [string, string]];
    const timezoneOptionText = (value: string, label: string) => label === value ? `${value.split('/').at(-1)?.replaceAll('_', ' ') ?? value}（${value}）` : label;
    const enhanceTimezoneSelect = (select: HTMLSelectElement) => {
      const allOptions = timezoneOptions.map(([value, label]) => [value, timezoneOptionText(value, label)] as [string, string]);
      const search = document.createElement('input');
      search.type = 'search';
      search.className = 'timezone-search';
      search.setAttribute('data-timezone-search', '');
      search.placeholder = '地域を検索（例：東京、UTC、New York）';
      search.setAttribute('aria-label', `${select.getAttribute('aria-label') ?? 'タイムゾーン'}を検索`);
      allOptions.forEach(([value, label]) => { if (![...select.options].some((option) => option.value === value)) select.add(new Option(label, value)); });
      const field = select.closest('label');
      if (field) field.insertAdjacentElement('beforebegin', search);
      else select.insertAdjacentElement('beforebegin', search);
      const renderOptions = (query = '') => {
        const normalized = query.trim().toLocaleLowerCase();
        const current = select.value;
        const matches = allOptions.filter(([value, label]) => !normalized || `${value} ${label}`.toLocaleLowerCase().includes(normalized));
        const visible = matches.slice(0, normalized ? 80 : 32);
        if (current && !visible.some(([value]) => value === current)) {
          const selected = allOptions.find(([value]) => value === current);
          if (selected) visible.unshift(selected);
        }
        const visibleValues = new Set(visible.map(([value]) => value));
        [...select.options].forEach((option) => { option.hidden = !visibleValues.has(option.value); option.selected = option.value === current; });
      };
      renderOptions();
      search.addEventListener('input', () => renderOptions(search.value));
    };
    root.querySelectorAll<HTMLSelectElement>('[data-calendar-timezone],[data-task-due-timezone],[data-event-timezone],[data-unavailable-timezone]').forEach(enhanceTimezoneSelect);
    const taskDue = get<HTMLInputElement>('[data-task-due]');
    const taskDueTimezone = get<HTMLSelectElement>('[data-task-due-timezone]');
    const taskReminderEmail = get<HTMLInputElement>('[data-task-reminder-email]');
    const taskReminderList = get<HTMLElement>('[data-task-reminder-list]');
    const progressFeedback = get<HTMLOutputElement>('[data-progress-feedback]');
    const taskFeedback = get<HTMLOutputElement>('[data-task-feedback]');
    const eventFeedback = get<HTMLOutputElement>('[data-event-feedback]');
    const reminderSettings = root.querySelector<HTMLElement>('.task-reminder-settings');
    let reminderDeliveryNote: HTMLElement | null = null;
    if (reminderSettings) {
      const heading = reminderSettings.querySelector<HTMLElement>('h3');
      const description = reminderSettings.querySelector<HTMLElement>(':scope > p');
      const emailLabel = reminderSettings.querySelector<HTMLElement>('[data-task-reminder-email]')?.parentElement;
      if (heading) heading.textContent = 'リマインダー（任意）';
      if (description) description.textContent = '期限を基準に設定できます。メールを入力すると通知ベルに加えてメールでも通知し、空欄なら通知ベルに表示します。';
      if (emailLabel?.firstChild) emailLabel.firstChild.textContent = 'このToDoの通知先メールアドレス（任意）';
      const toggle = document.createElement('button');
      toggle.type = 'button';
      toggle.className = 'task-reminder-toggle';
      toggle.textContent = 'リマインダーを設定する';
      toggle.setAttribute('aria-expanded', 'false');
      heading?.insertAdjacentElement('afterend', toggle);
      reminderDeliveryNote = document.createElement('p');
      reminderDeliveryNote.className = 'task-reminder-delivery-note';
      reminderSettings.append(reminderDeliveryNote);
      reminderSettings.classList.add('is-collapsed');
      toggle.addEventListener('click', () => {
        const collapsed = reminderSettings.classList.toggle('is-collapsed');
        toggle.textContent = collapsed ? 'リマインダーを設定する' : 'リマインダー設定を閉じる';
        toggle.setAttribute('aria-expanded', String(!collapsed));
      });
    }
    const wrapField = <T extends HTMLElement>(element: T, labelText: string) => {
      const label = document.createElement('label');
      label.className = 'field-label';
      const parent = element.parentNode;
      if (parent) parent.insertBefore(label, element);
      label.append(labelText, element);
      return label;
    };
    const taskTitle = get<HTMLInputElement>('[data-task-title]');
    const taskDetails = get<HTMLTextAreaElement>('[data-task-details]');
    const taskCreateButton = get<HTMLButtonElement>('[data-create-task]');
    const taskSection = taskTitle.closest<HTMLElement>('section');
    const taskCreatePanel = document.createElement('details');
    taskCreatePanel.className = 'task-create-panel';
    taskCreatePanel.open = true;
    taskCreatePanel.innerHTML = '<summary>ToDoを追加</summary>';
    const taskTitleField = wrapField(taskTitle, 'タスク名');
    const taskDetailsField = wrapField(taskDetails, '補足・依頼内容（任意）');
    taskSection?.querySelector(':scope > p')?.insertAdjacentElement('afterend', taskCreatePanel);
    [taskTitleField, taskTitleField.parentElement?.querySelector('[data-task-subject]')?.parentElement, taskTitleField.parentElement?.querySelector('[data-task-assignee]')?.parentElement, taskSection?.querySelector('.task-deadline'), reminderSettings, taskDetailsField, taskCreateButton, taskFeedback].forEach((element) => {
      if (element) taskCreatePanel.append(element);
    });
    const eventTitle = get<HTMLInputElement>('[data-event-title]');
    const eventStart = get<HTMLInputElement>('[data-event-start]');
    const eventEnd = get<HTMLInputElement>('[data-event-end]');
    const eventTimezone = get<HTMLSelectElement>('[data-event-timezone]');
    wrapField(eventTitle, '催し名');
    wrapField(eventStart, '開始日時');
    wrapField(eventEnd, '終了日時（任意）');
    wrapField(eventTimezone, '日程の基準タイムゾーン');
    const eventDetails = document.createElement('textarea');
    eventDetails.dataset.eventDetails = '';
    eventDetails.maxLength = 4000;
    eventDetails.rows = 2;
    eventDetails.placeholder = '開催場所、URL、持ち物など（任意）';
    const eventDetailsField = wrapField(eventDetails, '案内・開催場所（任意）');
    eventDetailsField.classList.add('event-details-field');
    const eventButton = get<HTMLButtonElement>('[data-create-event]');
    eventButton.before(eventDetailsField);
    const eventCreate = get<HTMLElement>('[data-event-create]');
    const eventManageLink = document.createElement('a');
    eventManageLink.className = 'event-manage-link';
    eventManageLink.href = '/admin/events/';
    eventManageLink.textContent = '日程一覧で追加・管理する';
    eventManageLink.hidden = true;
    eventCreate.insertAdjacentElement('beforebegin', eventManageLink);
    const escapeHtml = (value: string) => value.replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[character] ?? character);
    const anonymousMemberLabel = (value: string) => { const normalized = value.trim().toLowerCase(); let hash = 2166136261; for (const character of normalized) { hash ^= character.codePointAt(0) ?? 0; hash = Math.imul(hash, 16777619); } return String((hash >>> 0) % 9000 + 1000); };
    const memberDisplayName = (name: unknown, email: string) => { const value = String(name ?? '').trim(); return !value || value === '表示名未設定' ? anonymousMemberLabel(email) : value; };
    const api = async <T,>(url: string, method = 'GET', body?: unknown): Promise<T> => {
      const requestBody = url === '/api/admin/operations/events' && method === 'POST' && body && typeof body === 'object'
        ? { ...(body as Record<string, unknown>), details: root.querySelector<HTMLTextAreaElement>('[data-event-details]')?.value ?? '' }
        : body;
      const response = await fetch(url, { method, credentials: 'same-origin', cache: 'no-store', headers: requestBody === undefined ? {} : { 'content-type': 'application/json' }, body: requestBody === undefined ? undefined : JSON.stringify(requestBody) });
      const contentType = response.headers.get('content-type') ?? '';
      const data = contentType.includes('application/json') ? await response.json() as T & { error?: string } : null;
      if (!response.ok || !data) throw new Error(data?.error ?? '認証情報を確認できませんでした。ページを再読み込みしてください。');
