---
import AdminLayout from "../../../../layouts/AdminLayout.astro";
import AdminNav from "../../../../components/AdminNav.astro";
import AdminBreadcrumb from "../../../../components/AdminBreadcrumb.astro";
import AdminErrorActions from "../../../../components/AdminErrorActions.astro";

export function getStaticPaths() {
  return [
    { params: { slug: "atlas" } },
    { params: { slug: "seminar-platform" } },
    { params: { slug: "secretariat" } },
  ];
}

const { slug } = Astro.params;
const isAtlas = slug === "atlas";
const isSeminar = slug === "seminar-platform";
const projectName = isAtlas ? "アトラス学習サイト" : isSeminar ? "ゼミプラットフォーム" : "Atlasez運営事務局";
---

<AdminLayout title={`${projectName}のマイページ`} description={`${projectName}内のプロフィールと個人メモ`}>
  <main id="admin-main" class="project-workspace" data-project-workspace data-project-slug={slug}>
    <AdminNav current={isAtlas ? "atlas" : isSeminar ? "seminar" : "secretariat"} />
    <AdminErrorActions />
    <AdminBreadcrumb items={[{ label: "メンバー用サイト", href: "/admin/portal/" }, { label: projectName, href: isAtlas ? "/admin/atlas/" : isSeminar ? "/admin/projects/seminar-platform/" : "/admin/projects/secretariat/" }, { label: "マイページ" }]} />
    <header class="workspace-heading">
      <div><h1>{projectName}のマイページ</h1><p>このプロジェクト内で表示するプロフィールとメンバー紹介を管理します。</p></div>
      <a class="back-link" href={isAtlas ? "/admin/atlas/" : isSeminar ? "/admin/projects/seminar-platform/" : "/admin/projects/secretariat/"}>プロジェクトへ戻る</a>
    </header>
    <section class="profile-card" aria-labelledby="profile-title">
      <div><p class="eyebrow">共通プロフィール</p><h2 id="profile-title" data-profile-name>読み込み中…</h2><div class="facts"><span><b>所属</b><strong data-profile-university>確認中…</strong></span><span><b>学年</b><strong data-profile-year>確認中…</strong></span><span><b>担当・権限</b><strong data-profile-roles>確認中…</strong></span></div></div>
      <p class="muted">表示名・所属・学年・担当は全分野管理者が管理します。</p>
    </section>
    <section class="intro-card" aria-labelledby="intro-title">
      <div class="section-heading"><div><h2 id="intro-title">このプロジェクトでの自己紹介</h2><p>プロジェクトのメンバーに共有する内容を入力できます。</p></div><output data-message aria-live="polite"></output></div>
      <label class="input-label" for="project-introduction">自己紹介本文</label>
      <textarea id="project-introduction" data-introduction aria-describedby="intro-title" maxlength="12000" placeholder="担当や関心、参加できることなど"></textarea>
      <button type="button" class="primary-action" data-save>自己紹介を保存</button>
    </section>
    <section class="members-card" aria-labelledby="members-title">
      <div class="section-heading"><div><h2 id="members-title">プロジェクトメンバー</h2><p>このプロジェクトに参加しているメンバーの自己紹介を確認できます。</p></div><output data-members-message aria-live="polite">読み込み中…</output></div>
      <div class="member-list" data-project-members aria-live="polite" aria-busy="true"><p class="member-empty">読み込み中…</p></div>
    </section>
  </main>
</AdminLayout>

<style>
  .project-workspace{box-sizing:border-box;margin:0 auto;max-width:1100px;padding:0 1.25rem 4rem}.workspace-heading{align-items:end;border-bottom:1px solid var(--border-default);display:flex;gap:1rem;justify-content:space-between;padding:2.4rem 0 1.4rem}.eyebrow{color:var(--accent-primary);font-size:.72rem;font-weight:800;letter-spacing:.1em;margin:0 0 .35rem}.workspace-heading h1{font-size:clamp(1.75rem,4vw,2.5rem);letter-spacing:-.04em;margin:0}.workspace-heading p:last-child{color:var(--text-secondary);line-height:1.6;margin:.45rem 0 0}.back-link{color:var(--accent-primary);font-size:.8rem;font-weight:800;text-decoration:none;white-space:nowrap}.profile-card,.intro-card,.members-card{border:1px solid var(--border-default);border-top:3px solid var(--accent-primary);display:grid;gap:.8rem;margin:1.5rem auto 0;padding:1rem;width:min(100%,64rem)}.profile-card h2,.intro-card h2,.members-card h2{font-size:1.2rem;margin:.2rem 0 0}.facts{display:flex;flex-wrap:wrap;gap:.45rem;margin-top:.8rem}.facts span{background:var(--background-secondary);border:1px solid var(--border-default);display:grid;gap:.1rem;min-width:9rem;padding:.4rem .55rem}.facts b{color:var(--text-secondary);font-size:.68rem}.facts strong{font-size:.82rem;overflow-wrap:anywhere}.muted,.section-heading p:last-child{color:var(--text-secondary);font-size:.82rem;line-height:1.6;margin:0}.section-heading{align-items:start;border-bottom:1px solid var(--border-default);display:flex;gap:.7rem;justify-content:space-between;padding-bottom:.7rem}.section-heading output{color:var(--text-secondary);font-size:.78rem}.input-label{color:var(--text-secondary);font-size:.78rem;font-weight:800}.intro-card textarea{background:var(--background-primary);border:1px solid var(--border-default);box-sizing:border-box;color:var(--text-primary);font:inherit;line-height:1.65;min-height:14rem;padding:.7rem;resize:vertical;width:100%}.primary-action{background:var(--accent-primary);border:1px solid var(--accent-primary);color:#fff;cursor:pointer;font:inherit;font-size:.82rem;font-weight:800;justify-self:start;padding:.6rem .8rem}.primary-action:disabled{cursor:not-allowed;opacity:.6}.member-list{display:grid;gap:.65rem;grid-template-columns:repeat(auto-fit,minmax(18rem,1fr))}.member-card{background:var(--background-secondary);border:1px solid var(--border-default);display:grid;gap:.55rem;padding:.75rem}.member-card__top{align-items:center;display:flex;gap:.6rem}.member-avatar{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:50%;display:grid;flex:0 0 2.8rem;height:2.8rem;place-items:center;width:2.8rem}.member-avatar--image{overflow:hidden;position:relative}.member-avatar--image img{display:block;height:100%;object-fit:cover;width:100%}.member-avatar--image .member-avatar-fallback{display:none}.member-avatar--image[data-avatar-ready="failed"] .member-avatar-fallback{display:flex}.member-avatar--fallback{color:var(--accent-primary);font-size:1rem;font-weight:800}.member-avatar-fallback{align-items:center;display:flex;height:100%;justify-content:center;width:100%}.member-card__identity{display:grid;gap:.15rem;min-width:0}.member-card__identity strong{overflow-wrap:anywhere}.member-card__identity small{color:var(--text-secondary);font-size:.7rem}.member-card__facts{color:var(--text-secondary);display:flex;flex-wrap:wrap;font-size:.72rem;gap:.35rem}.member-card__introduction{border-top:1px solid var(--border-default);line-height:1.6;margin:0;padding-top:.5rem;white-space:pre-wrap}.member-empty{color:var(--text-secondary);margin:0;padding:.8rem 0}.member-count{color:var(--text-secondary);font-size:.78rem}@media(max-width:700px){.project-workspace{padding:0 .85rem 3rem}.workspace-heading{align-items:start;display:grid}.back-link{justify-self:start}.section-heading{display:grid}.facts{display:grid;grid-template-columns:1fr 1fr}.facts span{min-width:0}.member-list{grid-template-columns:1fr}}
</style>

<style is:global>
  /* メンバーカードはinnerHTMLで生成するため、Astroのスコープ属性なしでも適用する。 */
  [data-project-workspace] .member-card{background:var(--background-secondary);border:1px solid var(--border-default);display:grid;gap:.55rem;padding:.75rem}
  [data-project-workspace] .member-card__top{align-items:center;display:flex;gap:.6rem}
  [data-project-workspace] .member-avatar{background:var(--background-secondary);border:1px solid var(--border-default);border-radius:50%;display:grid;flex:0 0 2.8rem;height:2.8rem;place-items:center;width:2.8rem}
  [data-project-workspace] .member-avatar--image{overflow:hidden;position:relative}
  [data-project-workspace] .member-avatar--image img{display:block;height:100%;object-fit:cover;width:100%}
  [data-project-workspace] .member-avatar--image .member-avatar-fallback{display:none}
  [data-project-workspace] .member-avatar--image[data-avatar-ready="failed"] .member-avatar-fallback{display:flex}
  [data-project-workspace] .member-avatar--fallback{color:var(--accent-primary);font-size:1rem;font-weight:800}
  [data-project-workspace] .member-avatar-fallback{align-items:center;display:flex;height:100%;justify-content:center;width:100%}
  [data-project-workspace] .member-card__identity{display:grid;gap:.15rem;min-width:0}
  [data-project-workspace] .member-card__identity strong{overflow-wrap:anywhere}
  [data-project-workspace] .member-card__identity small{color:var(--text-secondary);font-size:.7rem}
  [data-project-workspace] .member-card__facts{color:var(--text-secondary);display:flex;flex-wrap:wrap;font-size:.72rem;gap:.35rem}
  [data-project-workspace] .member-card__introduction{border-top:1px solid var(--border-default);line-height:1.6;margin:0;padding-top:.5rem;white-space:pre-wrap}
  [data-project-workspace] .member-empty{color:var(--text-secondary);margin:0;padding:.8rem 0}
  @media(max-width:700px){[data-project-workspace] .member-card__top{align-items:flex-start}}
</style>

<script>
  type Profile={profile?:{email?:string;display_name?:string;university?:string;year?:string};roles?:string[]};
  const initializeProjectWorkspace=()=>{const root=document.querySelector<HTMLElement>('[data-project-workspace]');if(!root||root.dataset.initialized==='true')return;root.dataset.initialized='true';const slug=root.dataset.projectSlug??'';const name=root.querySelector<HTMLElement>('[data-profile-name]')!;const university=root.querySelector<HTMLElement>('[data-profile-university]')!;const year=root.querySelector<HTMLElement>('[data-profile-year]')!;const roles=root.querySelector<HTMLElement>('[data-profile-roles]')!;const intro=root.querySelector<HTMLTextAreaElement>('[data-introduction]')!;const save=root.querySelector<HTMLButtonElement>('[data-save]')!;const message=root.querySelector<HTMLOutputElement>('[data-message]')!;const anonymousMemberLabel=(value:string)=>{const normalized=value.trim().toLowerCase();let hash=2166136261;for(const character of normalized){hash^=character.codePointAt(0)??0;hash=Math.imul(hash,16777619);}return String((hash>>>0)%9000+1000);};const api=async<T,>(url:string,options:RequestInit={})=>{const response=await fetch(url,{...options,credentials:'same-origin',cache:'no-store',headers:{'content-type':'application/json',...(options.headers??{})}});const type=response.headers.get('content-type')??'';const data=type.includes('application/json')?await response.json() as T&{error?:string}:null;if(!response.ok||!data||data.error)throw new Error(data?.error??'情報を読み込めませんでした。');return data;};const load=async()=>{const [profile,project]=await Promise.all([api<Profile>('/api/admin/profile'),api<{introduction?:string}>(`/api/admin/projects/${encodeURIComponent(slug)}/profile`)]);const profileLabel=profile.profile?.display_name?.trim();name.textContent=profileLabel&&profileLabel!=='表示名未設定'?profileLabel:anonymousMemberLabel(profile.profile?.email??'');university.textContent=profile.profile?.university?.trim()||'未登録';year.textContent=profile.profile?.year?.trim()||'未登録';roles.textContent=profile.roles?.join('・')||'未設定';intro.value=project.introduction??'';};save.addEventListener('click',()=>{save.disabled=true;message.value='保存中…';void api(`/api/admin/projects/${encodeURIComponent(slug)}/profile`,{method:'PUT',body:JSON.stringify({introduction:intro.value})}).then(()=>{message.value='保存しました。';}).catch(error=>{message.value=error instanceof Error?error.message:'保存できませんでした。';}).finally(()=>{save.disabled=false;});});void load().catch(error=>{message.value=error instanceof Error?error.message:'プロフィールを読み込めませんでした。';});};document.addEventListener('astro:page-load',initializeProjectWorkspace);initializeProjectWorkspace();
</script>

<script>
  type SharedProjectMember = { displayName: string; role: "manager" | "member"; university?: string; year?: string; avatarUrl?: string; introduction?: string };
  const initializeProjectMembers = () => {
    const root = document.querySelector<HTMLElement>("[data-project-workspace]");
    if (!root || root.dataset.membersInitialized === "true") return;
    root.dataset.membersInitialized = "true";
    const slug = root.dataset.projectSlug ?? "";
    const list = root.querySelector<HTMLElement>("[data-project-members]");
    const message = root.querySelector<HTMLOutputElement>("[data-members-message]");
    const save = root.querySelector<HTMLButtonElement>("[data-save]");
    if (!list || !message) return;
    const escapeHtml = (value: unknown) => String(value ?? "").replace(/[&<>"']/g, (character) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[character] ?? character));
    const roleLabel = (role: SharedProjectMember["role"]) => role === "manager" ? "プロジェクト管理者" : "メンバー";
    const hydrateAvatars = () => {
      list.querySelectorAll<HTMLElement>("[data-member-avatar-url]").forEach((avatarElement) => {
        if (avatarElement.dataset.avatarReady) return;
        const source = avatarElement.dataset.memberAvatarUrl;
        const fallback = avatarElement.querySelector<HTMLElement>(".member-avatar-fallback");
        if (!source) return;
        const image = document.createElement("img");
        image.alt = "";
        image.decoding = "async";
        image.loading = "lazy";
        image.addEventListener("load", () => { if (fallback) fallback.hidden = true; });
        image.addEventListener("error", () => { image.remove(); if (fallback) fallback.hidden = false; avatarElement.dataset.avatarReady = "failed"; });
        avatarElement.prepend(image);
        image.src = source;
        avatarElement.dataset.avatarReady = "true";
        if (image.complete && image.naturalWidth > 0 && fallback) fallback.hidden = true;
      });
    };
    const render = (members: SharedProjectMember[]) => {
      message.value = members.length ? `${members.length}人` : "";
      list.setAttribute("aria-busy", "false");
      list.innerHTML = members.length ? members.map((member) => {
        const name = member.displayName.trim() || "表示名未設定";
        const facts = [member.university, member.year].filter((value) => value?.trim()).map((value) => escapeHtml(value)).join(" ・ ");
        const avatar = member.avatarUrl
          ? `<span class="member-avatar member-avatar--image" data-member-avatar-url="${escapeHtml(member.avatarUrl)}" aria-hidden="true"><span class="member-avatar-fallback">${escapeHtml(name.slice(0, 1))}</span></span>`
          : `<span class="member-avatar member-avatar--fallback" aria-hidden="true"><span class="member-avatar-fallback">${escapeHtml(name.slice(0, 1))}</span></span>`;
        return `<article class="member-card"><div class="member-card__top">${avatar}<div class="member-card__identity"><strong>${escapeHtml(name)}</strong><small>${escapeHtml(roleLabel(member.role))}</small></div></div>${facts ? `<div class="member-card__facts">${facts}</div>` : ""}<p class="member-card__introduction">${member.introduction?.trim() ? escapeHtml(member.introduction) : '<span class="member-empty">自己紹介は未登録です。</span>'}</p></article>`;
      }).join("") : '<p class="member-empty">このプロジェクトにはまだメンバーが登録されていません。</p>';
      hydrateAvatars();
    };
    const load = async () => {
      const response = await fetch(`/api/admin/projects/${encodeURIComponent(slug)}/profile`, { credentials: "same-origin", cache: "no-store" });
      const type = response.headers.get("content-type") ?? "";
      const data = type.includes("application/json") ? await response.json() as { members?: SharedProjectMember[]; error?: string } : null;
      if (!response.ok || !data) throw new Error(data?.error ?? "メンバー紹介を読み込めませんでした。");
      render(data.members ?? []);
    };
    void load().catch((error) => {
      const text = error instanceof Error ? error.message : "メンバー紹介を読み込めませんでした。";
      message.value = text;
      list.setAttribute("aria-busy", "false");
      list.innerHTML = `<p class="member-empty">${escapeHtml(text)}</p>`;
    });
    save?.addEventListener("click", () => { window.setTimeout(() => { void load(); }, 700); });
  };
  document.addEventListener("astro:page-load", initializeProjectMembers);
  initializeProjectMembers();
</script>
