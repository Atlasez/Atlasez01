---
/**
 * ヘッダー内の検索入力欄。
 * 検索は「行き先」ではなく「操作」なので、ナビゲーションのタブから外して
 * ヘッダー上部に常設する。表示切替のあるページでは現在の表示を検索し、
 * 「全体で検索」から記事横断検索へ移動できる。
 */
import { t, type Locale } from "../lib/i18n";
import { atlasPath } from "../lib/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const action = atlasPath(locale, "search");
---

<form
  class="header-search"
  role="search"
  action={action}
  method="get"
  data-header-search
  data-context-placeholder-tiles={t(locale, "tileSearchPlaceholder")}
  data-context-placeholder-list={t(locale, "listSearchPlaceholder")}
  data-context-placeholder-map={t(locale, "mapSearchPlaceholder")}
  data-context-label-tiles={t(locale, "tileSearchLabel")}
  data-context-label-list={t(locale, "listSearchLabel")}
  data-context-label-map={t(locale, "mapSearchLabel")}
>
  <label class="visually-hidden" for="header-search-input" data-context-search-label>
    {t(locale, "searchLabel")}
  </label>
  <input
    id="header-search-input"
    class="header-search-input"
    type="search"
    name="q"
    autocomplete="off"
    placeholder={t(locale, "searchPlaceholder")}
    data-context-search-input
  />
  <button type="submit" class="header-search-button" data-context-search-submit>
    {t(locale, "search")}
  </button>
  <button
    type="submit"
    class="header-global-search-button"
    data-global-search
    formaction={action}
    formmethod="get"
  >
    {t(locale, "globalSearch")}
  </button>
</form>

<style>
  .header-search {
    display: flex;
    align-items: stretch;
    flex: 1 1 14rem;
    min-width: 0;
    max-width: 26rem;
  }
  .header-search-input {
    flex: 1;
    min-width: 0;
    min-height: var(--touch-target);
    border: 1px solid var(--border-strong);
    border-right: 0;
    border-radius: var(--radius) 0 0 var(--radius);
    background: var(--background-primary);
    color: var(--text-primary);
    font: inherit;
    font-size: calc(0.9rem * var(--text-scale));
    padding: 0 var(--space-2);
  }
  .header-search-input:focus-visible {
    outline: 2px solid var(--accent-primary);
    outline-offset: -2px;
  }
  .header-search-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    min-height: var(--touch-target);
    /* 「検索」の2文字が折り返さない幅を確保する */
    padding: 0 var(--space-3);
    border: 1px solid var(--accent-primary);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--accent-primary);
    color: var(--on-accent);
    font: inherit;
    font-size: calc(0.9rem * var(--text-scale));
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
  }
  .header-search-button:hover {
    filter: brightness(1.1);
  }
  .header-global-search-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    min-height: var(--touch-target);
    padding: 0 var(--space-2);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--background-primary);
    color: var(--text-primary);
    font: inherit;
    font-size: calc(0.82rem * var(--text-scale));
    white-space: nowrap;
    cursor: pointer;
  }
  .header-global-search-button:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
  }
  /* 狭い画面ではヘッダーの1行を丸ごと使う。
     入力欄は 16px を下限にする（iOS Safari が 16px 未満で自動拡大するため。
     base.css の要素指定はクラス指定に負けるので、ここで明示する）。 */
  @media (max-width: 900px) {
    .header-search {
      max-width: none;
    }
    .header-search-input {
      font-size: max(16px, calc(0.9rem * var(--text-scale)));
    }
    .header-global-search-button {
      padding-inline: var(--space-1);
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-header-search]");
  const input = form?.querySelector<HTMLInputElement>("[data-context-search-input]");
  const label = form?.querySelector<HTMLLabelElement>("[data-context-search-label]");
  const defaultPlaceholder = input?.placeholder ?? "";
  const defaultLabel = label?.textContent ?? "";
  const contextHost = document.querySelector<HTMLElement>(
    "[data-home-layout], [data-subject-layout], [data-category-layout], [data-map-page]",
  );

  function activeView(): string {
    if (!contextHost) return "global";
    if (contextHost?.hasAttribute("data-map-page")) return "map";
    return contextHost?.dataset.activeView ?? "tiles";
  }

  function syncContext(view: string): void {
    if (!form || !input || !label) return;
    if (view === "global") {
      input.placeholder = defaultPlaceholder;
      label.textContent = defaultLabel;
      input.setAttribute("aria-label", defaultLabel);
      return;
    }
    const key = view === "map" || view === "list" ? view : "tiles";
    input.placeholder = form.dataset[`contextPlaceholder${key[0].toUpperCase()}${key.slice(1)}`] ?? input.placeholder;
    label.textContent = form.dataset[`contextLabel${key[0].toUpperCase()}${key.slice(1)}`] ?? label.textContent;
    input.setAttribute("aria-label", label.textContent);
  }

  if (form && input) {
    syncContext(activeView());
    window.addEventListener("atlas:view-change", (event) => {
      const view = (event as CustomEvent<{ view?: string }>).detail?.view;
      if (view) syncContext(view);
    });
    document.querySelectorAll<HTMLButtonElement>("[data-view-tab]").forEach((tab) => {
      tab.addEventListener("click", () => syncContext(tab.dataset.viewTab ?? "tiles"));
    });
    form.addEventListener("submit", (event) => {
      const submitter = event.submitter as HTMLElement | null;
      if (submitter?.hasAttribute("data-global-search")) return;
      if (!contextHost) return;
      event.preventDefault();
      document.dispatchEvent(
        new CustomEvent("atlas:context-search", {
          detail: { view: activeView(), query: input.value },
        }),
      );
    });
  }
</script>
