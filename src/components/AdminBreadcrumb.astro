---
/**
 * 運営サイト用の軽量なパンくず。
 * AdminNav の Home 項目を減らしても、現在地と戻り先が分かるようにする。
 */
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  items: readonly Crumb[];
  ariaLabel?: string;
}
const { items, ariaLabel = "パンくずリスト" } = Astro.props;
const visibleItems = items.filter((item) => item.label.trim());
---

<nav class="admin-breadcrumb" aria-label={ariaLabel}>
  <ol>
    {visibleItems.map((item, index) => (
      <li>
        {index === visibleItems.length - 1 ? (
          <span aria-current="page">{item.label}</span>
        ) : item.href ? (
          <a href={item.href} data-astro-reload>{item.label}</a>
        ) : (
          <span>{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
  .admin-breadcrumb {
    box-sizing: border-box;
    margin: 0;
    max-width: none;
    padding: .8rem 0 0;
    width: 100%;
  }
  .admin-breadcrumb ol {
    align-items: center;
    color: var(--text-secondary);
    display: flex;
    flex-wrap: wrap;
    font-size: .74rem;
    gap: .35rem;
    list-style: none;
    margin: 0;
    min-width: 0;
    padding: 0;
  }
  .admin-breadcrumb li { align-items: center; display: inline-flex; gap: .35rem; max-width: 100%; min-width: 0; }
  .admin-breadcrumb li:not(:last-child)::after { color: var(--text-secondary); content: "›"; }
  .admin-breadcrumb a,
  .admin-breadcrumb [aria-current="page"] { overflow-wrap: anywhere; }
  .admin-breadcrumb a { color: var(--accent-primary); text-decoration: none; }
  .admin-breadcrumb a:hover,
  .admin-breadcrumb a:focus-visible { text-decoration: underline; }
  .admin-breadcrumb [aria-current="page"] { color: var(--text-secondary); }
  @media (max-width: 700px) {
    .admin-breadcrumb { padding-top: .65rem; }
    .admin-breadcrumb ol { align-items: flex-start; font-size: .7rem; line-height: 1.45; }
    .admin-breadcrumb li { align-items: flex-start; }
  }
</style>
