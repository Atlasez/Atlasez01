---
/** 学習サイト「アトラス」の共通レイアウト（ロケール対応） */
import BaseHead from "../components/BaseHead.astro";
import A11ySettings from "../components/A11ySettings.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { withBase, atlasPath, ORG } from "../lib/site";
import { t, LOCALES, localeNames, type Locale } from "../lib/i18n";

interface AlternateLink {
  hreflang: string;
  href: string;
}
interface Props {
  locale: Locale;
  title: string;
  description: string;
  ogType?: "website" | "article";
  alternates?: AlternateLink[];
  structuredData?: object;
  /** 言語切替リンク先（省略時は各ロケールの総合ホーム） */
  localeSwitchHrefs?: Record<string, string>;
  /** 検索エンジンにインデックスさせない（内容が空のページなど） */
  noindex?: boolean;
}
const {
  locale,
  title,
  description,
  ogType,
  alternates = [],
  structuredData,
  localeSwitchHrefs = {},
  noindex = false,
} = Astro.props;

const nav = [
  { label: t(locale, "subjects"), href: atlasPath(locale) },
  {
    label: locale === "ja" ? "学習リスト" : "Learning list",
    href: atlasPath(locale, "bookmarks"),
  },
  { label: t(locale, "forBeginners"), href: atlasPath(locale, "guide") },
  { label: t(locale, "team"), href: atlasPath(locale, "team") },
];
const currentPath = Astro.url.pathname;
const showLanguageSwitch = LOCALES.length > 1;
---

<!doctype html>
<html lang={locale} data-site="atlas">
  <head>
    <BaseHead
      title={`${title} | ${t(locale, "siteName")}`}
      description={description}
      ogType={ogType}
      alternates={alternates}
      structuredData={structuredData}
      noindex={noindex}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">{t(locale, "skipToContent")}</a>
    <header class="atlas-header">
      <div class="container atlas-header-inner">
        <a class="atlas-logo" href={atlasPath(locale)}>
          <img
            src={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/images/atlasez-logo.png`}
            alt=""
            width="40"
            height="40"
          />
          <span>{locale === "ja" ? "アトラス" : "Atlas"}</span>
        </a>
        <button
          class="nav-toggle button button-secondary"
          type="button"
          aria-controls="atlas-main-nav"
          aria-expanded="false"
          data-nav-toggle
        >
          {locale === "ja" ? "メニュー" : "Menu"}
        </button>
        <nav
          id="atlas-main-nav"
          class="main-nav"
          aria-label={locale === "ja" ? "メインナビゲーション" : "Main navigation"}
          data-main-nav
        >
          <ul class="atlas-nav">
            {
              nav.map((item) => (
                <li class:list={{ "guide-nav-item": item.href.endsWith("/guide/") }}>
                  <a
                    href={item.href}
                    aria-current={currentPath === item.href ? "page" : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <form
          class="header-search"
          role="search"
          action={atlasPath(locale, "search")}
        >
          <label class="visually-hidden" for="atlas-header-search">
            {t(locale, "search")}
          </label>
          <input
            id="atlas-header-search"
            type="search"
            name="q"
            placeholder={t(locale, "searchPlaceholder")}
          />
          <button type="submit" aria-label={t(locale, "search")}>
            {t(locale, "search")}
          </button>
        </form>
        <details class="header-tools">
          <summary>
            {
              showLanguageSwitch
                ? locale === "ja"
                  ? "表示・言語"
                  : "Display & language"
                : locale === "ja"
                  ? "表示設定"
                  : "Display settings"
            }
          </summary>
          <div class="header-tools-panel">
            {
              showLanguageSwitch && (
                <div class="language-control">
                  <label for="atlas-language-select">
                    {t(locale, "languages")}
                  </label>
                  <select id="atlas-language-select" data-language-select>
                    {LOCALES.map((language) => (
                      <option
                        value={
                          localeSwitchHrefs[language] ?? atlasPath(language)
                        }
                        selected={language === locale}
                      >
                        {localeNames[language]}
                      </option>
                    ))}
                  </select>
                </div>
              )
            }
            <ThemeToggle locale={locale} />
            <A11ySettings locale={locale} />
          </div>
        </details>
        <a class="org-link" href={withBase("/")} title="Atlasez">Atlasez</a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="atlas-footer">
      <div class="container atlas-footer-inner">
        <div>
          <p class="atlas-footer-title">{t(locale, "siteName")}</p>
          <p>{t(locale, "siteTagline")}</p>
          <p>
            {t(locale, "operatedBy")}:
            <a href={withBase("/")}>Atlasez</a> ・
            <a href={ORG.atlasSns.x} rel="noopener noreferrer" target="_blank"
              >X (@learning_atlas)</a
            >
          </p>
          <p>
            <a href={withBase("/privacy-policy/")}>
              {locale === "ja" ? "プライバシーポリシー" : "Privacy Policy"}
            </a>
          </p>
        </div>
      </div>
      <p class="container atlas-copyright">© 2024-2026 Atlasez</p>
    </footer>
  </body>
</html>

<style>
  .atlas-header {
    border-top: 3px solid var(--accent-primary);
    border-bottom: 1px solid var(--border-default);
    background: var(--background-primary);
  }
  .atlas-header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    flex-wrap: wrap;
    padding-block: var(--space-2);
  }
  .atlas-logo {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-weight: 700;
    font-size: calc(1.15rem * var(--text-scale));
    color: var(--accent-primary);
    text-decoration: none;
    min-height: var(--touch-target);
  }
  .atlas-nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav-toggle {
    display: none;
    margin-left: auto;
  }
  .atlas-nav a {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    padding: 0 var(--space-2);
    text-decoration: none;
    color: var(--text-primary);
    border-bottom: 2px solid transparent;
  }
  .atlas-nav a:hover,
  .atlas-nav a[aria-current="page"] {
    border-bottom-color: var(--accent-primary);
    color: var(--accent-primary);
  }
  .guide-nav-item a {
    border: 1px solid var(--accent-primary);
    border-radius: var(--radius);
    color: var(--accent-primary);
    font-weight: 650;
  }
  .header-search {
    display: flex;
    min-width: min(19rem, 28vw);
    margin-left: auto;
  }
  .header-search input {
    min-width: 0;
    width: 100%;
    min-height: var(--touch-target);
    border-radius: var(--radius) 0 0 var(--radius);
  }
  .header-search button {
    min-width: 3.5rem;
    min-height: var(--touch-target);
    padding-inline: var(--space-2);
    border: 1px solid var(--accent-primary);
    border-radius: 0 var(--radius) var(--radius) 0;
    background: var(--accent-primary);
    color: white;
    font: inherit;
    white-space: nowrap;
    cursor: pointer;
  }
  .header-tools {
    position: relative;
  }
  .header-tools > summary {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    padding-inline: var(--space-2);
    border: 1px solid var(--border-default);
    border-radius: var(--radius);
    font-size: calc(0.85rem * var(--text-scale));
    cursor: pointer;
  }
  .header-tools-panel {
    position: absolute;
    z-index: 20;
    right: 0;
    top: calc(100% + var(--space-1));
    width: min(32rem, calc(100vw - var(--space-4)));
    max-height: min(36rem, 75vh);
    overflow-y: auto;
    padding: var(--space-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    box-shadow: 0 0.5rem 1.5rem rgb(0 0 0 / 0.16);
    background: var(--background-primary);
  }
  .language-control {
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--border-default);
  }
  .language-control label {
    display: block;
    margin-bottom: var(--space-1);
    font-weight: 650;
  }
  .language-control select {
    width: 100%;
  }
  .language-control p {
    margin: var(--space-1) 0 0;
    color: var(--text-secondary);
    font-size: calc(0.78rem * var(--text-scale));
  }
  .header-tools :global(.theme-toggle) {
    width: 100%;
    margin-bottom: var(--space-2);
  }
  .org-link {
    font-size: calc(0.9rem * var(--text-scale));
    color: var(--text-secondary);
  }
  main {
    min-height: 60vh;
    padding-block: var(--space-3);
  }
  .atlas-footer {
    border-top: 1px solid var(--border-default);
    background: var(--background-primary);
    padding-block: var(--space-5);
    font-size: calc(0.9rem * var(--text-scale));
  }
  .atlas-footer-inner {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--space-4);
  }
  .atlas-footer-title {
    font-weight: 700;
    margin-top: 0;
  }
  .atlas-copyright {
    margin-top: var(--space-4);
    color: var(--text-secondary);
  }
  @media (max-width: 767px) {
    .atlas-header-inner {
      gap: var(--space-2);
    }
    .atlas-logo {
      margin-right: auto;
    }
    .nav-toggle {
      display: inline-flex;
      margin-left: 0;
    }
    .main-nav {
      display: none;
      order: 4;
      width: 100%;
      border-top: 1px solid var(--border-default);
    }
    .main-nav[data-open] {
      display: block;
    }
    .atlas-nav {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      width: 100%;
      padding-block: var(--space-1);
    }
    .atlas-nav a {
      width: 100%;
      padding-inline: var(--space-2);
    }
    .org-link {
      display: none;
    }
    .header-search {
      order: 3;
      width: 100%;
      margin-left: 0;
    }
    .header-tools {
      margin-left: 0;
    }
  }
</style>

<script>
  const navToggle =
    document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const mainNav = document.querySelector<HTMLElement>("[data-main-nav]");

  navToggle?.addEventListener("click", () => {
    if (!mainNav) return;
    const open = !mainNav.hasAttribute("data-open");
    mainNav.toggleAttribute("data-open", open);
    navToggle.setAttribute("aria-expanded", String(open));
  });

  document
    .querySelector<HTMLSelectElement>("[data-language-select]")
    ?.addEventListener("change", (event) => {
      const select = event.currentTarget as HTMLSelectElement;
      if (select.value) window.location.assign(select.value);
    });
</script>
