{
  "name": "atlasez-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Atlasez公式サイトと学習サイト「アトラス」",
  "scripts": {
    "dev": "astro dev",
    "dev:reports": "npx --yes wrangler dev --config wrangler.local.jsonc --local --port 8787",
    "db:reports:local": "npx --yes wrangler d1 migrations apply atlasez-reports-local --local --config wrangler.local.jsonc",
    "new:article": "node scripts/new-article.mjs",
    "update:institutions": "node scripts/build-institution-directory.mjs",
    "build": "node scripts/write-build-info.mjs && astro build && npm run search:index",
    "deploy:production": "node scripts/verify-production-deploy.mjs && npx wrangler deploy --config wrangler.jsonc",
    "verify:deploy-config": "node scripts/verify-deployment-config.mjs",
    "build:ci": "astro build",
    "search:index": "pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint src scripts tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "validate:content": "astro build --config astro.config.mjs > /dev/null && node scripts/validate-content.mjs && node scripts/validate-article-media.mjs",
    "validate:media": "node scripts/validate-article-media.mjs",
    "test": "vitest run",
    "audit:math": "node scripts/audit-math.mjs",
    "migrate:math-directives": "node scripts/migrate-math-directives.mjs --write",
    "check:math-directives": "node scripts/migrate-math-directives.mjs --check",
    "test:e2e": "playwright test",
    "astro": "astro",
    "check:i18n": "node --experimental-strip-types scripts/check-ui-translations.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^7.1.3",
    "cytoscape": "^3.30.0",
    "katex": "^0.16.0",
    "node-tikzjax": "^1.0.5",
    "rehype-katex": "^7.0.0",
    "rehype-mathjax": "^7.1.0",
    "rehype-raw": "^7.0.0",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "sharp": "^0.35.4",
    "unified": "^11.0.5",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "eslint": "^10.8.0",
    "jsdom": "^26.1.0",
    "pagefind": "^1.3.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "wrangler": "4.127.0"
  }
}
