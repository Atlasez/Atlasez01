{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlasez01",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-26",
  "vars": {
    "DISCORD_REPORT_SYNC_URL": "https://atlasez-admin.ukyoukay0.workers.dev/internal/article-report-discord",
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "REPORTS",
      "database_name": "atlasez-reports",
      "database_id": "d5112a62-7ed6-49c8-b6a2-18ee2dbab678",
    },
  ],
}
